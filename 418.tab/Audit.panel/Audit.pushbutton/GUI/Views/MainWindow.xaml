<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Titre}"
        Width="1200" Height="820"
        MinWidth="920" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource TransparentBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

  <!--
    Fenêtre Audit — 1er consommateur de la coquille commune (barre commune Fluent).

    Chargement
    - Ce XAML est chargé via XamlReader.Load (PAS de x:Class, PAS de code-behind).
    - Les dictionnaires de thème (Colors/Styles + variantes Dark) sont fusionnés
      dans window.Resources APRÈS le parse.
    - CONSÉQUENCE : tout brush/style de thème est référencé via DynamicResource.

    Chrome custom borderless
    - WindowStyle="None" + AllowsTransparency : chrome dessiné par le Border racine.
    - WindowChrome : redimensionnement / maximize corrects (CaptionHeight=0 pour
      laisser le TitleBar custom gérer le DragMove côté Python).
    - TitleBar (x:Name requis) : le Python y câble DragMove().
    - Boutons de légende nommés : MinimizeButton / MaximizeRestoreButton / CloseButton.
  -->

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>

  <!-- Border racine : coins arrondis, fond de fenêtre -->
  <Border CornerRadius="12"
          Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!--
        Barre de titre (draggable côté Python via x:Name="TitleBar").
        Titre à gauche, boutons de légende à droite.
      -->
      <Grid Grid.Row="0" x:Name="TitleBar"
            Height="44"
            Background="{DynamicResource TransparentBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="418 · Audit — Santé du modèle"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12.5"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="14,0,0,0"/>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
          <Button x:Name="MinimizeButton"
                  Content="&#x2013;"
                  Style="{DynamicResource CaptionButtonStyle}"/>
          <Button x:Name="MaximizeRestoreButton"
                  Content="&#x25A1;"
                  Style="{DynamicResource CaptionButtonStyle}"/>
          <Button x:Name="CloseButton"
                  Content="&#x2715;"
                  Style="{DynamicResource CaptionCloseButtonStyle}"/>
        </StackPanel>
      </Grid>

      <!-- Corps : rail (Width 64) + surface de contenu (*) -->
      <Grid Grid.Row="1" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
          Rail de navigation : DockPanel vertical.
          Logo en haut, conteneur de nav (vide), Paramètres poussé en bas.
        -->
        <DockPanel Grid.Column="0"
                   LastChildFill="True"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,10">

          <!-- Pastille logo de marque (dégradé accent) -->
          <Border DockPanel.Dock="Top"
                  Style="{DynamicResource BrandLogoBorderStyle}"
                  Margin="0,0,0,8">
            <Image Source="{Binding BrandLogoPath}" Width="30" Height="30"/>
          </Border>

          <!-- Paramètres poussé tout en bas -->
          <RadioButton DockPanel.Dock="Bottom"
                       Style="{DynamicResource NavRailButtonStyle}"
                       Content="&#x2699;"
                       ToolTip="Paramètres"/>

          <!-- Conteneur de navigation (prend l'espace restant) -->
          <StackPanel Orientation="Vertical"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
            <!-- items de nav à venir -->
          </StackPanel>
        </DockPanel>

        <!-- Surface de contenu flottante -->
        <Border Grid.Column="1"
                Style="{DynamicResource ShellSurfaceStyle}"
                Margin="6,0,12,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--
              Zone de contenu : dashboard Audit.
              Ressources de gravité partagées par pastilles/pills/lignes :
                Critique -> ErrorBrush (rouge)
                À revoir -> WarningBrush (orange)
                Conforme -> SuccessBrush (vert)
              Toutes via DynamicResource (XamlReader + merge après parse).
            -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,18,20,18">
              <StackPanel Orientation="Vertical">

                <!-- Bandeau contexte modèle -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,20">
                  <TextBlock Text="{Binding Titre}"
                             Style="{DynamicResource SubHeaderTextBlockStyle}"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ===== Vue d'ensemble ===== -->
                <TextBlock Text="VUE D'ENSEMBLE"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,24">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="380"/>
                  </Grid.ColumnDefinitions>

                  <!-- 1. Principaux problèmes critiques -->
                  <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0">
                    <StackPanel>
                      <TextBlock Text="Principaux problèmes critiques"
                                 Style="{DynamicResource BodyTextBlockStyle}"
                                 FontWeight="SemiBold"
                                 FontSize="13"
                                 Margin="0,0,0,10"/>
                      <ItemsControl ItemsSource="{Binding TopCritiques}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,6,16,6">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>

                              <!-- Pastille de gravité -->
                              <Border x:Name="SevBadge"
                                      Grid.Column="0"
                                      Background="{DynamicResource ErrorBrush}"
                                      CornerRadius="5"
                                      Padding="7,3"
                                      VerticalAlignment="Top"
                                      Margin="0,1,10,0">
                                <TextBlock Text="{Binding Gravite}"
                                           Foreground="{DynamicResource TextOnDangerBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                              </Border>

                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Nom}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Emplacement}"
                                           Foreground="{DynamicResource TextDisabledBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                              </StackPanel>
                            </Grid>

                            <DataTemplate.Triggers>
                              <DataTrigger Binding="{Binding Gravite}" Value="À revoir">
                                <Setter TargetName="SevBadge" Property="Background" Value="{DynamicResource WarningBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Gravite}" Value="Conforme">
                                <Setter TargetName="SevBadge" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                              </DataTrigger>
                            </DataTemplate.Triggers>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <!-- Donut (remplace la carte de barres) : répartition par thème + score + légende -->
                  <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Margin="0">
                    <StackPanel HorizontalAlignment="Center">
                      <!-- Donut : répartition des problèmes par thème, score au centre -->
                      <Grid Width="176" Height="176" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding ScoreVM.DonutSegments}"
                                      Width="176" Height="176">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <Canvas Width="176" Height="176"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Path Data="{Binding PathData}">
                                <Path.Style>
                                  <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Cle}" Value="warnings">
                                        <Setter Property="Fill" Value="{DynamicResource CatWarningsBrush}"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding Cle}" Value="purge">
                                        <Setter Property="Fill" Value="{DynamicResource CatPurgeBrush}"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding Cle}" Value="vues_feuilles">
                                        <Setter Property="Fill" Value="{DynamicResource CatVuesBrush}"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding Cle}" Value="cad">
                                        <Setter Property="Fill" Value="{DynamicResource CatCadBrush}"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding Cle}" Value="nommage">
                                        <Setter Property="Fill" Value="{DynamicResource CatNommageBrush}"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Path.Style>
                              </Path>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                          <TextBlock Text="{Binding ScoreVM.Score}"
                                     FontSize="42" FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                          <TextBlock Text="/ 100"
                                     FontSize="12"
                                     HorizontalAlignment="Center"
                                     Foreground="{DynamicResource TextDisabledBrush}"/>
                        </StackPanel>
                      </Grid>

                      <!-- Tag coloré selon le niveau (excellent/bon/correct/critique) -->
                      <Border CornerRadius="14" Padding="18,7"
                              HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ScoreVM.Niveau}" Value="excellent">
                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding ScoreVM.Niveau}" Value="bon">
                                <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding ScoreVM.Niveau}" Value="critique">
                                <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ScoreVM.NiveauLibelle}"
                                   Foreground="{DynamicResource TextOnDangerBrush}"
                                   FontSize="14" FontWeight="Bold"/>
                      </Border>

                      <!-- Synthèse -->
                      <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding ScoreVM.NbProblemes}"/><Run Text=" problèmes · "/><Run Text="{Binding ScoreVM.NbCritiques}"/><Run Text=" critiques"/>
                      </TextBlock>

                      <!-- Légende du donut : une couleur par thème + compte -->
                      <ItemsControl ItemsSource="{Binding ScoreVM.DonutSegments}" Margin="0,18,0,0" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,3">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,9,0">
                                <Ellipse.Style>
                                  <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Cle}" Value="warnings"><Setter Property="Fill" Value="{DynamicResource CatWarningsBrush}"/></DataTrigger>
                                      <DataTrigger Binding="{Binding Cle}" Value="purge"><Setter Property="Fill" Value="{DynamicResource CatPurgeBrush}"/></DataTrigger>
                                      <DataTrigger Binding="{Binding Cle}" Value="vues_feuilles"><Setter Property="Fill" Value="{DynamicResource CatVuesBrush}"/></DataTrigger>
                                      <DataTrigger Binding="{Binding Cle}" Value="cad"><Setter Property="Fill" Value="{DynamicResource CatCadBrush}"/></DataTrigger>
                                      <DataTrigger Binding="{Binding Cle}" Value="nommage"><Setter Property="Fill" Value="{DynamicResource CatNommageBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Ellipse.Style>
                              </Ellipse>
                              <TextBlock Grid.Column="1" Text="{Binding Libelle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Grid.Column="2" Text="{Binding Compte}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- ===== Détail par thème ===== -->
                <TextBlock Text="DÉTAIL PAR THÈME"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           Margin="0,0,0,10"/>

                <ItemsControl ItemsSource="{Binding Cartes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                        <Expander Style="{DynamicResource CollectionExpanderStyle}"
                                  IsExpanded="{Binding EstDeplie, Mode=TwoWay}">
                          <Expander.Header>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>

                              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Libelle}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                              </StackPanel>

                              <!-- Pill de comptage + pire gravité -->
                              <Border x:Name="ThemePill"
                                      Grid.Column="1"
                                      Background="{DynamicResource ErrorBrush}"
                                      CornerRadius="12"
                                      Padding="10,4"
                                      VerticalAlignment="Center">
                                <TextBlock Foreground="{DynamicResource TextOnDangerBrush}"
                                           FontSize="12"
                                           FontWeight="Bold">
                                  <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                      <Binding Path="Compte"/>
                                      <Binding Path="PireGravite"/>
                                    </MultiBinding>
                                  </TextBlock.Text>
                                </TextBlock>
                              </Border>
                            </Grid>
                          </Expander.Header>

                          <!-- Corps déplié : soit indisponible, soit tableau des lignes -->
                          <Grid Margin="0,10,0,0">
                            <!-- Thème indisponible (check désactivé) -->
                            <TextBlock x:Name="UnavailableMsg"
                                       Text="Analyse indisponible pour ce thème."
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       FontSize="12.5"
                                       Visibility="Collapsed"/>

                            <!-- Tableau des lignes -->
                            <StackPanel x:Name="RowsPanel">
                              <!-- En-têtes -->
                              <Grid Margin="12,0,12,6">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="2*"/>
                                  <ColumnDefinition Width="2*"/>
                                  <ColumnDefinition Width="1.4*"/>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ÉLÉMENT" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextDisabledBrush}"/>
                                <TextBlock Grid.Column="1" Text="EMPLACEMENT" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextDisabledBrush}"/>
                                <TextBlock Grid.Column="2" Text="TYPE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextDisabledBrush}"/>
                                <TextBlock Grid.Column="3" Text="GRAVITÉ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextDisabledBrush}"/>
                                <TextBlock Grid.Column="4" Text="ACTION" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextDisabledBrush}"/>
                              </Grid>

                              <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,9">
                                      <Grid>
                                        <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="2*"/>
                                          <ColumnDefinition Width="2*"/>
                                          <ColumnDefinition Width="1.4*"/>
                                          <ColumnDefinition Width="Auto"/>
                                          <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Nom}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Emplacement}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12.5"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Type}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RowSev"
                                                   Grid.Column="3"
                                                   Text="{Binding Gravite}"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="4"
                                                Content="Voir"
                                                Command="{Binding selectionner_cmd}"
                                                Style="{DynamicResource SecondaryActionButtonStyle}"
                                                Padding="8,2"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"/>
                                      </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                      <DataTrigger Binding="{Binding Gravite}" Value="À revoir">
                                        <Setter TargetName="RowSev" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding Gravite}" Value="Conforme">
                                        <Setter TargetName="RowSev" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                      </DataTrigger>
                                    </DataTemplate.Triggers>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Grid>
                        </Expander>
                      </Border>

                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding PireGravite}" Value="À revoir">
                          <Setter TargetName="ThemePill" Property="Background" Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PireGravite}" Value="Conforme">
                          <Setter TargetName="ThemePill" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Disponible}" Value="False">
                          <Setter TargetName="UnavailableMsg" Property="Visibility" Value="Visible"/>
                          <Setter TargetName="RowsPanel" Property="Visibility" Value="Collapsed"/>
                          <Setter TargetName="ThemePill" Property="Background" Value="{DynamicResource TextDisabledBrush}"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </ScrollViewer>

            <!-- Footer d'actions -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,14">
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right">
                <Button Content="Exporter le rapport"
                        Command="{Binding exporter_cmd}"
                        Style="{DynamicResource SecondaryActionButtonStyle}"
                        Margin="0,0,10,0"/>
                <Button Content="Relancer l'audit"
                        Command="{Binding relancer_cmd}"
                        Style="{DynamicResource PrimaryActionButtonStyle}"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
