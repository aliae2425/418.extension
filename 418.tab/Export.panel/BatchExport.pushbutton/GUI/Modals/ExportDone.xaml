<!-- -*- coding: utf-8 -*- -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        MaxWidth="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

  <Border Background="{DynamicResource WindowBackgroundBrush}"
          BorderBrush="{DynamicResource ControlBorderBrush}"
          BorderThickness="1"
          CornerRadius="8">
    <StackPanel>

      <!-- Barre de titre -->
      <Grid x:Name="TitleBar"
            Height="44"
            Background="Transparent"
            Cursor="SizeAll">
        <TextBlock Text="Export terminé"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"/>
        <Button x:Name="CloseButton"
                Content="✕"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                Width="28"
                Height="28"
                FontSize="11"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Cursor="Hand"
                Padding="0"/>
      </Grid>

      <Rectangle Height="1"
                 Fill="{DynamicResource ControlBorderBrush}"/>

      <!-- Contenu -->
      <StackPanel Margin="20,16,20,20">

        <TextBlock x:Name="DestinationBlock"
                   TextWrapping="Wrap"
                   FontSize="12.5"
                   LineHeight="20"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
          <Button x:Name="OpenFolderButton"
                  Content="Ouvrir dans l'explorateur"
                  Style="{DynamicResource SecondaryActionButtonStyle}"
                  Margin="0,0,8,0"/>
          <Button x:Name="CloseFermerButton"
                  Content="Fermer"
                  Style="{DynamicResource PrimaryActionButtonStyle}"/>
        </StackPanel>

      </StackPanel>
    </StackPanel>
  </Border>
</Window>
