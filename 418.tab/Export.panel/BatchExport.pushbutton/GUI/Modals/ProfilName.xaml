<!-- -*- coding: utf-8 -*- -->
<!--
  Saisie du nom d'un profil. Remplace `pyrevit.forms.ask_for_string`, dont
  l'apparence (WinForms/pyRevit) jurait avec le reste de l'outil.
  Même structure que ExportDone.xaml : Border arrondi + TitleBar draggable
  (câblée par BaseWindow) + contenu.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

  <Border Background="{DynamicResource WindowBackgroundBrush}"
          BorderBrush="{DynamicResource ControlBorderBrush}"
          BorderThickness="1"
          CornerRadius="8">
    <StackPanel>

      <!-- Barre de titre -->
      <Grid x:Name="TitleBar"
            Height="44"
            Background="Transparent"
            Cursor="SizeAll">
        <TextBlock Text="Enregistrer le profil"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"/>
        <Button x:Name="CloseButton"
                Content="✕"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                Width="28"
                Height="28"
                FontSize="11"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Cursor="Hand"
                Padding="0"/>
      </Grid>

      <Rectangle Height="1"
                 Fill="{DynamicResource ControlBorderBrush}"/>

      <!-- Contenu -->
      <StackPanel Margin="20,16,20,20">

        <TextBlock Text="Les réglages courants (nommage, setups d'impression, organisation) seront enregistrés sous ce nom."
                   TextWrapping="Wrap"
                   FontSize="12.5"
                   LineHeight="20"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,12"/>

        <TextBox x:Name="NomTextBox"
                 Height="32"
                 VerticalContentAlignment="Center"
                 Padding="8,0"/>

        <TextBlock x:Name="ErreurBlock"
                   Text=""
                   TextWrapping="Wrap"
                   FontSize="12"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource ErrorBrush}"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
          <Button x:Name="AnnulerButton"
                  Content="Annuler"
                  Style="{DynamicResource SecondaryActionButtonStyle}"
                  Margin="0,0,8,0"/>
          <Button x:Name="ValiderButton"
                  Content="Enregistrer"
                  IsDefault="True"
                  Style="{DynamicResource PrimaryActionButtonStyle}"/>
        </StackPanel>

      </StackPanel>
    </StackPanel>
  </Border>
</Window>
