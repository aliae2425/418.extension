<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Titre}"
        Width="760" Height="540"
        MinWidth="600" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource TransparentBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

  <!--
    Fenêtre BatchExport — montée sur la coquille commune (barre commune Fluent),
    calquée sur Audit.panel/Audit.pushbutton/GUI/Views/MainWindow.xaml.

    Chargement
    - Ce XAML est chargé via XamlReader.Load (PAS de x:Class, PAS de code-behind).
    - Les dictionnaires de thème (Colors/Styles + variantes Dark) sont fusionnés
      dans window.Resources APRÈS le parse.
    - CONSÉQUENCE : tout brush/style de thème est référencé via DynamicResource.

    Chrome custom borderless
    - WindowStyle="None" + AllowsTransparency : chrome dessiné par le Border racine.
    - WindowChrome : redimensionnement / maximize corrects (CaptionHeight=0 pour
      laisser le TitleBar custom gérer le DragMove côté Python).
    - TitleBar (x:Name requis) : le Python y câble DragMove().
    - Boutons de légende nommés : MinimizeButton / MaximizeRestoreButton / CloseButton.

    Rail de navigation
    - NavAuto / NavManual / NavSettings partagent GroupName="nav" (sélection exclusive).
    - Mode manuel (IsManual) : contenu réel hors périmètre, la surface affiche
      pour l'instant un placeholder lié à SurfaceTitre.
    - Mode Paramètres (IsSettings) : panneau réel (PanneauParametres) qui
      mappe les 3 paramètres Oui/Non de collection (Export/Carnet/DWG).

    Mode « par jeu » (Collections)
    - `MainViewModel.Collections` (property CLR) expose une LISTE de
      `CollectionItemVM` (dérivant de `BaseViewModel`, propriétés CLR
      `Titre`/`Id`/`FlagExport`/`FlagCarnet`/`FlagDwg`/`Qualified`/`Sheets`).
      Chaque `Sheets` est une liste de `SheetItemVM` (propriétés `Numero`/
      `Nom`/`NomProjete`). Ce pattern (objet à @property dérivé de
      BaseViewModel) est celui déjà utilisé pour `{Binding Titre}` sur la
      fenêtre elle-même : il bind de façon fiable, contrairement à un
      `dict` Python qui n'expose pas de propriétés CLR nommées.
    - Bindings donc en syntaxe PROPRIÉTÉ classique (`{Binding Titre}`,
      `{Binding Sheets}`, etc.), pas en syntaxe indexeur.
  -->

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Local à cette fenêtre : bascule Visibility selon IsAuto/IsNotAuto (mode « par jeu »). -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
  </Window.Resources>

  <!-- Border racine : coins arrondis, fond de fenêtre -->
  <Border CornerRadius="12"
          Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!--
        Barre de titre (draggable côté Python via x:Name="TitleBar").
        Titre à gauche, boutons de légende à droite.
      -->
      <Grid Grid.Row="0" x:Name="TitleBar"
            Height="44"
            Background="{DynamicResource TransparentBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="418 · Export — Feuilles &amp; jeux"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12.5"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"/>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
          <Button x:Name="MinimizeButton"
                  Content="&#x2013;"
                  Style="{DynamicResource CaptionButtonStyle}"/>
          <Button x:Name="MaximizeRestoreButton"
                  Content="&#x25A1;"
                  Style="{DynamicResource CaptionButtonStyle}"/>
          <Button x:Name="CloseButton"
                  Content="&#x2715;"
                  Style="{DynamicResource CaptionCloseButtonStyle}"/>
        </StackPanel>
      </Grid>

      <!-- Corps : rail (Width 64) + surface de contenu (*) -->
      <Grid Grid.Row="1" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
          Rail de navigation : DockPanel vertical.
          Logo en haut, items Auto/Manuel au centre, Paramètres poussé en bas.
        -->
        <DockPanel Grid.Column="0"
                   LastChildFill="True"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,10">

          <!-- Pastille logo de marque (dégradé accent) -->
          <Border DockPanel.Dock="Top"
                  Style="{DynamicResource BrandLogoBorderStyle}"
                  Margin="0,0,0,10">
            <Image Source="{Binding BrandLogoPath}" Width="30" Height="30"/>
          </Border>

          <!-- Paramètres poussé tout en bas -->
          <RadioButton x:Name="NavSettings"
                       DockPanel.Dock="Bottom"
                       Style="{DynamicResource NavRailButtonStyle}"
                       Content="&#x2699;"
                       ToolTip="Paramètres"
                       GroupName="nav"/>

          <!-- Conteneur de navigation (prend l'espace restant) -->
          <StackPanel Orientation="Vertical"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
            <RadioButton x:Name="NavAuto"
                         Style="{DynamicResource NavRailButtonStyle}"
                         Content="&#x25A6;"
                         ToolTip="Par jeu — préprogrammé"
                         GroupName="nav"
                         IsChecked="True"/>
            <RadioButton x:Name="NavManual"
                         Style="{DynamicResource NavRailButtonStyle}"
                         Content="&#x2611;"
                         ToolTip="Feuille par feuille — manuel"
                         GroupName="nav"/>
          </StackPanel>
        </DockPanel>

        <!-- Surface de contenu flottante -->
        <Border Grid.Column="1"
                Style="{DynamicResource ShellSurfaceStyle}"
                Margin="6,0,12,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--
              En-tête de surface : titre du mode + badge de compte
              (jeux qualifiés / feuilles qualifiées). Visible uniquement
              en mode « par jeu » (IsAuto).
            -->
            <Grid Grid.Row="0"
                  Margin="20,16,20,8"
                  Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibilityConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                         Text="{Binding SurfaceTitre}"
                         Style="{DynamicResource SubHeaderTextBlockStyle}"
                         VerticalAlignment="Center"/>

              <!-- Badge de compte : "N jeux · M feuilles" -->
              <Border Grid.Column="1"
                      Background="{DynamicResource ControlFillBrush}"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="10,4"
                      VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding NbJeuxQualifies}"
                             Foreground="{DynamicResource AccentBrush}"
                             FontWeight="SemiBold"
                             FontSize="12.5"/>
                  <TextBlock Text=" jeux qualifiés · "
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12.5"/>
                  <TextBlock Text="{Binding NbFeuillesQualifiees}"
                             Foreground="{DynamicResource AccentBrush}"
                             FontWeight="SemiBold"
                             FontSize="12.5"/>
                  <TextBlock Text=" feuilles"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12.5"/>
                </StackPanel>
              </Border>
            </Grid>

            <!--
              Zone de contenu — mode « par jeu » : liste des collections
              (lecture seule). ItemsSource = MainViewModel.Collections
              (liste de CollectionItemVM). Chaque item est bindé via la
              syntaxe PROPRIÉTÉ {Binding Cle} — voir note en tête de
              fichier sur le pattern CollectionItemVM/SheetItemVM.
            -->
            <ScrollViewer Grid.Row="1"
                          Margin="20,0,20,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibilityConverter}}">
              <ItemsControl ItemsSource="{Binding Collections}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!--
                      Carte de collection. Opacity abaissée si la collection
                      n'est pas qualifiée (Qualified == False).

                      Repli par défaut (#3) : la sous-liste des feuilles est
                      logée dans un Expander (IsExpanded="False"), stylé via
                      CollectionExpanderStyle (socle Styles/StylesDark.xaml).
                      L'en-tête (Titre + badges) est fourni en contenu INLINE
                      via Expander.Header — PAS de HeaderTemplate — afin de
                      rester dans le namescope de ce DataTemplate : les
                      DataTrigger ci-dessous ciblent BadgeExport/BadgeCarnet/
                      BadgeDwg par TargetName et doivent continuer à résoudre.
                    -->
                    <Border Style="{DynamicResource CardStyle}"
                            x:Name="CollectionCard">
                      <Expander Style="{DynamicResource CollectionExpanderStyle}"
                                IsExpanded="False">
                        <Expander.Header>
                          <!-- En-tête de collection : Titre + 3 badges de rôle -->
                          <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Titre}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">

                              <!-- Badge EXPORT -->
                              <Border x:Name="BadgeExport"
                                      Background="{DynamicResource ControlFillBrush}"
                                      BorderBrush="{DynamicResource ControlBorderBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Padding="8,3"
                                      Margin="4,0,0,0">
                                <TextBlock x:Name="BadgeExportText"
                                           Text="EXPORT"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}"/>
                              </Border>

                              <!-- Badge CARNET -->
                              <Border x:Name="BadgeCarnet"
                                      Background="{DynamicResource ControlFillBrush}"
                                      BorderBrush="{DynamicResource ControlBorderBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Padding="8,3"
                                      Margin="4,0,0,0">
                                <TextBlock x:Name="BadgeCarnetText"
                                           Text="CARNET"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}"/>
                              </Border>

                              <!-- Badge DWG -->
                              <Border x:Name="BadgeDwg"
                                      Background="{DynamicResource ControlFillBrush}"
                                      BorderBrush="{DynamicResource ControlBorderBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Padding="8,3"
                                      Margin="4,0,0,0">
                                <TextBlock x:Name="BadgeDwgText"
                                           Text="DWG"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}"/>
                              </Border>
                            </StackPanel>
                          </Grid>
                        </Expander.Header>

                        <!--
                          Sous-liste des feuilles de la collection.
                          ItemsSource = Sheets (liste de SheetItemVM) ;
                          binding propriété également pour Numero/Nom/NomProjete.
                        -->
                        <ItemsControl ItemsSource="{Binding Sheets}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="90"/>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Numero}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12.5"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Nom}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12.5"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="8,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding NomProjete}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           FontStyle="Italic"
                                           TextTrimming="CharacterEllipsis"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </Border>

                    <DataTemplate.Triggers>
                      <!-- Collection non qualifiée (Qualified == False) : grisée -->
                      <DataTrigger Binding="{Binding Qualified}" Value="False">
                        <Setter TargetName="CollectionCard" Property="Opacity" Value="0.5"/>
                      </DataTrigger>

                      <!-- Badge EXPORT actif si FlagExport == True (vert = SuccessBrush) -->
                      <DataTrigger Binding="{Binding FlagExport}" Value="True">
                        <Setter TargetName="BadgeExport" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                        <Setter TargetName="BadgeExport" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                        <Setter TargetName="BadgeExportText" Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                      </DataTrigger>

                      <!-- Badge CARNET actif si FlagCarnet == True (bleu = AccentBrush, inchangé) -->
                      <DataTrigger Binding="{Binding FlagCarnet}" Value="True">
                        <Setter TargetName="BadgeCarnet" Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <Setter TargetName="BadgeCarnet" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter TargetName="BadgeCarnetText" Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                      </DataTrigger>

                      <!-- Badge DWG actif si FlagDwg == True (ambre = WarningBrush) -->
                      <DataTrigger Binding="{Binding FlagDwg}" Value="True">
                        <Setter TargetName="BadgeDwg" Property="Background" Value="{DynamicResource WarningBrush}"/>
                        <Setter TargetName="BadgeDwg" Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                        <Setter TargetName="BadgeDwgText" Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!--
              Placeholder pour le mode « manuel » (Phase 4/5, hors périmètre
              de cette tâche) : contenu réel à venir. Le mode « Paramètres »
              a désormais son propre panneau ci-dessous (PanneauParametres).
            -->
            <TextBlock Grid.Row="1"
                       Text="{Binding SurfaceTitre}"
                       Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibilityConverter}}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!--
              Mode « Paramètres » (IsSettings) : mappage des 3 paramètres
              Oui/Non de collection -> rôle (Export / Carnet / DWG). La
              sélection est persistée par les setters ParamExport/ParamCarnet/
              ParamDwg (MainViewModel) qui déclenchent aussi refresh_par_jeu()
              -> les badges/qualification du mode « par jeu » se mettent à
              jour immédiatement au changement.
            -->
            <StackPanel Grid.Row="1"
                        x:Name="PanneauParametres"
                        Orientation="Vertical"
                        Margin="20,16,20,8"
                        Visibility="{Binding IsSettings, Converter={StaticResource BoolToVisibilityConverter}}">

              <TextBlock Text="Mappage des paramètres de collection"
                         Style="{DynamicResource SubHeaderTextBlockStyle}"
                         Margin="0,0,0,4"/>
              <TextBlock Text="Choisissez, pour chaque rôle, le paramètre Oui/Non de collection qui qualifie les jeux."
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="12.5"
                         TextWrapping="Wrap"
                         Margin="0,0,0,16"/>

              <Border Style="{DynamicResource CardStyle}">
                <StackPanel Orientation="Vertical">

                  <!-- Ligne Export -->
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Export"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox Grid.Column="1"
                              x:Name="ParamExportCombo"
                              ItemsSource="{Binding ParametresDisponibles}"
                              SelectedItem="{Binding ParamExport, Mode=TwoWay}"/>
                  </Grid>

                  <!-- Ligne Carnet -->
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Carnet"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox Grid.Column="1"
                              x:Name="ParamCarnetCombo"
                              ItemsSource="{Binding ParametresDisponibles}"
                              SelectedItem="{Binding ParamCarnet, Mode=TwoWay}"/>
                  </Grid>

                  <!-- Ligne DWG -->
                  <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="DWG"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox Grid.Column="1"
                              x:Name="ParamDwgCombo"
                              ItemsSource="{Binding ParametresDisponibles}"
                              SelectedItem="{Binding ParamDwg, Mode=TwoWay}"/>
                  </Grid>

                </StackPanel>
              </Border>

              <!-- En-tête de section : options d'export -->
              <TextBlock Text="Options d'export"
                         Style="{DynamicResource SubHeaderTextBlockStyle}"
                         Margin="0,20,0,4"/>
              <TextBlock Text="Configurez les setups Revit utilisés pour l'export PDF et DWG."
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="12.5"
                         TextWrapping="Wrap"
                         Margin="0,0,0,16"/>

              <!--
                Les 2 toggles d'organisation (sous-dossier par jeu / séparer
                PDF-DWG) ont été déplacés sous le champ destination, dans le
                footer (voir section « Sous-dossier et format » ci-dessous) :
                ils sont pertinents quel que soit le mode (Auto/Manuel), donc
                visibles en permanence plutôt qu'enfouis dans Paramètres.
              -->
              <Border Style="{DynamicResource CardStyle}">
                <StackPanel Orientation="Vertical">

                  <!-- Ligne Setup PDF -->
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Setup PDF"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox Grid.Column="1"
                              x:Name="SetupPdfCombo"
                              ItemsSource="{Binding SetupsPdf}"
                              SelectedItem="{Binding SetupPdf, Mode=TwoWay}"/>
                  </Grid>

                  <!-- Ligne Setup DWG -->
                  <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Setup DWG"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox Grid.Column="1"
                              x:Name="SetupDwgCombo"
                              ItemsSource="{Binding SetupsDwg}"
                              SelectedItem="{Binding SetupDwg, Mode=TwoWay}"/>
                  </Grid>

                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Footer d'actions -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Retour visuel export (Task 3) : StatusText, mis à jour
                     via progress_cb/log_cb de ExportOrchestrator. La
                     ProgressBar (liée ProgressValue) a été retirée de l'UI ;
                     la propriété ProgressValue reste disponible côté VM. -->
                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                  <!-- Dossier de destination courant (Task « Parcourir »). -->
                  <TextBlock x:Name="DestinationPathTextBlock"
                             Text="{Binding DestinationPath, StringFormat='Destination : {0}'}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12"
                             HorizontalAlignment="Left"
                             TextTrimming="CharacterEllipsis"
                             Margin="0,0,0,10"/>

                  <!--
                    Sous-dossier et format : les 2 interrupteurs d'organisation
                    de l'export (déplacés depuis Paramètres, cf. carte
                    « Options d'export »), regroupés sous le champ destination
                    car pertinents quel que soit le mode (Auto/Manuel).
                  -->
                  <TextBlock Text="Sous-dossier et format"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Margin="0,0,0,6"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox Content="Sous-dossier par jeu"
                              Style="{DynamicResource ToggleSwitchStyle}"
                              IsChecked="{Binding CreerSousDossiers, Mode=TwoWay}"
                              Margin="0,4,20,4"/>
                    <CheckBox Content="Séparer PDF / DWG"
                              Style="{DynamicResource ToggleSwitchStyle}"
                              IsChecked="{Binding SeparerFormats, Mode=TwoWay}"
                              Margin="0,4"/>
                  </StackPanel>

                  <TextBlock x:Name="StatusTextBlock"
                             Text="{Binding StatusText}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                  <Button x:Name="SecondaryActionButton"
                          Content="Parcourir…"
                          Style="{DynamicResource SecondaryActionButtonStyle}"
                          Margin="0,0,10,0"/>
                  <Button x:Name="PrimaryActionButton"
                          Content="Exporter"
                          Style="{DynamicResource PrimaryActionButtonStyle}"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
