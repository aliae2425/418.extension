<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Titre}"
        Width="760" Height="540"
        MinWidth="600" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource TransparentBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

  <!--
    Fenêtre BatchExport — montée sur la coquille commune (barre commune Fluent),
    calquée sur Audit.panel/Audit.pushbutton/GUI/Views/MainWindow.xaml.

    Chargement
    - Ce XAML est chargé via XamlReader.Load (PAS de x:Class, PAS de code-behind).
    - Les dictionnaires de thème (Colors/Styles + variantes Dark) sont fusionnés
      dans window.Resources APRÈS le parse.
    - CONSÉQUENCE : tout brush/style de thème est référencé via DynamicResource.

    Chrome custom borderless
    - WindowStyle="None" + AllowsTransparency : chrome dessiné par le Border racine.
    - WindowChrome : redimensionnement / maximize corrects (CaptionHeight=0 pour
      laisser le TitleBar custom gérer le DragMove côté Python).
    - TitleBar (x:Name requis) : le Python y câble DragMove().
    - Boutons de légende nommés : MinimizeButton / MaximizeRestoreButton / CloseButton.

    Rail de navigation
    - NavAuto / NavManual / NavSettings partagent GroupName="nav" (sélection exclusive).
    - Mode manuel (IsManual) : contenu réel hors périmètre, la surface affiche
      pour l'instant un placeholder lié à SurfaceTitre.
    - Mode Paramètres (IsSettings) : panneau réel (PanneauParametres) qui
      mappe les 3 paramètres Oui/Non de collection (Export/Carnet/DWG).

    Mode « par jeu » (Collections)
    - `MainViewModel.Collections` (property CLR) expose une LISTE de
      `CollectionItemVM` (dérivant de `BaseViewModel`, propriétés CLR
      `Titre`/`Id`/`FlagExport`/`FlagCarnet`/`FlagDwg`/`Qualified`/`Sheets`).
      Chaque `Sheets` est une liste de `SheetItemVM` (propriétés `Numero`/
      `Nom`/`NomProjete`). Ce pattern (objet à @property dérivé de
      BaseViewModel) est celui déjà utilisé pour `{Binding Titre}` sur la
      fenêtre elle-même : il bind de façon fiable, contrairement à un
      `dict` Python qui n'expose pas de propriétés CLR nommées.
    - Bindings donc en syntaxe PROPRIÉTÉ classique (`{Binding Titre}`,
      `{Binding Sheets}`, etc.), pas en syntaxe indexeur.
  -->

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Local à cette fenêtre : bascule Visibility selon IsAuto/IsNotAuto (mode « par jeu »). -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
  </Window.Resources>

  <!-- Border racine : coins arrondis, fond de fenêtre -->
  <Border CornerRadius="12"
          Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!--
        Barre de titre (draggable côté Python via x:Name="TitleBar").
        Titre à gauche, boutons de légende à droite.
      -->
      <Grid Grid.Row="0" x:Name="TitleBar"
            Height="44"
            Background="{DynamicResource TransparentBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="418 · Export — Feuilles &amp; jeux"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12.5"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"/>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
          <Button x:Name="MinimizeButton"
                  Content="&#x2013;"
                  Style="{DynamicResource CaptionButtonStyle}"/>
          <Button x:Name="MaximizeRestoreButton"
                  Content="&#x25A1;"
                  Style="{DynamicResource CaptionButtonStyle}"/>
          <Button x:Name="CloseButton"
                  Content="&#x2715;"
                  Style="{DynamicResource CaptionCloseButtonStyle}"/>
        </StackPanel>
      </Grid>

      <!-- Corps : rail (Width 64) + surface de contenu (*) -->
      <Grid Grid.Row="1" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
          Rail de navigation : DockPanel vertical.
          Logo en haut, items Auto/Manuel au centre, Paramètres poussé en bas.
        -->
        <DockPanel Grid.Column="0"
                   LastChildFill="True"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,10">

          <!-- Pastille logo de marque (dégradé accent) -->
          <Border DockPanel.Dock="Top"
                  Style="{DynamicResource BrandLogoBorderStyle}"
                  Margin="0,0,0,10">
            <Image Source="{Binding BrandLogoPath}" Width="30" Height="30"/>
          </Border>

          <!-- Paramètres poussé tout en bas -->
          <RadioButton x:Name="NavSettings"
                       DockPanel.Dock="Bottom"
                       Style="{DynamicResource NavRailButtonStyle}"
                       Content="&#x2699;"
                       ToolTip="Paramètres"
                       GroupName="nav"/>

          <!-- Conteneur de navigation (prend l'espace restant) -->
          <StackPanel Orientation="Vertical"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
            <RadioButton x:Name="NavAuto"
                         Style="{DynamicResource NavRailButtonStyle}"
                         Content="&#x25A6;"
                         ToolTip="Par jeu — préprogrammé"
                         GroupName="nav"
                         IsChecked="True"/>
            <RadioButton x:Name="NavManual"
                         Style="{DynamicResource NavRailButtonStyle}"
                         Content="&#x2611;"
                         ToolTip="Feuille par feuille — manuel"
                         GroupName="nav"/>
          </StackPanel>
        </DockPanel>

        <!-- Surface de contenu flottante -->
        <Border Grid.Column="1"
                Style="{DynamicResource ShellSurfaceStyle}"
                Margin="6,0,12,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--
              En-tête de surface : titre du mode + badge de compte
              (jeux qualifiés / feuilles qualifiées). Visible uniquement
              en mode « par jeu » (IsAuto).
            -->
            <Grid Grid.Row="0"
                  Margin="20,16,20,8"
                  Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibilityConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                         Text="{Binding SurfaceTitre}"
                         Style="{DynamicResource SubHeaderTextBlockStyle}"
                         VerticalAlignment="Center"/>

              <!-- Badge de compte : "N jeux · M feuilles" -->
              <Border Grid.Column="1"
                      Background="{DynamicResource ControlFillBrush}"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="10,4"
                      VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding NbJeuxQualifies}"
                             Foreground="{DynamicResource AccentBrush}"
                             FontWeight="SemiBold"
                             FontSize="12.5"/>
                  <TextBlock Text=" jeux qualifiés · "
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12.5"/>
                  <TextBlock Text="{Binding NbFeuillesQualifiees}"
                             Foreground="{DynamicResource AccentBrush}"
                             FontWeight="SemiBold"
                             FontSize="12.5"/>
                  <TextBlock Text=" feuilles"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12.5"/>
                </StackPanel>
              </Border>
            </Grid>

            <!--
              Zone de contenu — mode « par jeu » : liste des collections
              (lecture seule). ItemsSource = MainViewModel.Collections
              (liste de CollectionItemVM). Chaque item est bindé via la
              syntaxe PROPRIÉTÉ {Binding Cle} — voir note en tête de
              fichier sur le pattern CollectionItemVM/SheetItemVM.
            -->
            <!-- SPIKE etape 0 : page Auto hebergee (chargee separement, DataContext = AutoPageVM) -->
            <ContentControl Grid.Row="1"
                            x:Name="AutoPageHost"
                            Margin="20,0,20,8"
                            Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!--
              Mode « feuille par feuille » (IsManual) : recherche + filtre +
              compteur + liste des feuilles avec tags PDF/DWG par ligne.

              Structure calquée sur le mode « par jeu » ci-dessus pour la
              cohérence visuelle (CardStyle pour la barre outils, ScrollViewer
              + ItemsControl pour la liste, colonnes Numero/Nom identiques à
              la sous-liste des feuilles d'une collection).

              Bindings (MainViewModel) :
              - RechercheManuel (TwoWay, PropertyChanged) : texte de recherche.
              - FiltresManuel : liste de FiltreItemVM (multi-sélection par
                case à cocher, propriétés .Label / .IsActif TwoWay).
              - NbFeuillesManuel / NbPdf / NbDwg : compteurs recalculés à
                chaque changement de recherche/filtre/toggle.
              - SheetsManuelFiltrees : liste de ManualSheetVM (Numero, Nom,
                JeuNom, NomProjete, ExportPdf TwoWay, ExportDwg TwoWay). Pas
                de case de sélection de ligne : redondante avec ExportPdf/
                ExportDwg (une ligne sans aucun format actif n'est jamais
                exportée, cf. selection_manuelle()).
            -->
            <Grid Grid.Row="1"
                  Margin="20,16,20,8"
                  Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibilityConverter}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!--
                Rangée recherche + filtre, côte à côte, ratio 2/3 - 1/3.
                Gauche : TextBox de recherche pleine largeur de sa colonne.
                Droite : menu déroulant de filtres MULTI-SÉLECTION.

                Approche retenue : ToggleButton + Popup (PAS de ComboBox).
                Une ComboBox avec des CheckBox dans son ItemTemplate est
                connue pour être fragile sans code-behind : cliquer sur un
                item referme le popup (ClickMode="Press" du ToggleButton
                interne, cf. ComboBoxStyle du socle) et/ou la ComboBox tente
                de piloter SelectedItem/SelectedIndex, ce qui entre en
                conflit avec la sélection multi-cases : comportement que ce
                XAML (chargé via XamlReader.Load, sans code-behind pour
                compenser) ne peut pas fiabiliser. Le couple ToggleButton +
                Popup donne un contrôle total sur l'ouverture/fermeture et
                laisse les CheckBox de l'ItemsControl interne gérer leur
                propre toggle sans interférence.

                - FiltreToggle (ToggleButton) : habillé d'un Border arrondi
                  (ControlFillBrush/ControlBorderBrush, CornerRadius 8) pour
                  s'aligner visuellement sur la TextBox de recherche à
                  gauche : un ToggleButton nu n'a pas de style dans le
                  socle (Styles.xaml n'en définit que pour l'intérieur des
                  ControlTemplate Expander/ComboBox), donc chrome Win32 par
                  défaut sans cet habillage.
                - Texte affiché : résumé via {Binding FiltresResume}
                  (MainViewModel), pas le Label d'un item : il n'y a pas de
                  sélection unique à refléter.
                - Popup : StaysOpen="False" (se ferme au clic extérieur) ;
                  IsOpen bindé TWO-WAY sur FiltreToggle.IsChecked (pas
                  one-way) : sans le TwoWay, un clic extérieur ferme le
                  Popup mais laisse le ToggleButton visuellement coché (état
                  désynchronisé, le menu ne se rouvre plus au clic suivant).
                - DataContext du contenu du Popup fixé EXPLICITEMENT sur
                  celui de FiltreToggle : l'héritage du DataContext à travers
                  un Popup (fenêtre séparée dans l'arbre visuel) n'est pas
                  fiable ; sans ce binding explicite, {Binding FiltresManuel}
                  peut résoudre sur un DataContext vide et afficher une liste
                  déroulante vide.
              -->
              <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*"/>
                  <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                  <TextBlock Text="Rechercher une feuille…"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Margin="0,0,0,6"/>
                  <TextBox Text="{Binding RechercheManuel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical">
                  <TextBlock Text="Filtrer par"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Margin="0,0,0,6"/>

                  <ToggleButton x:Name="FiltreToggle"
                                Height="35"
                                Focusable="False"
                                HorizontalContentAlignment="Stretch">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="FiltreToggleBorder"
                                Background="{DynamicResource ControlFillBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,0">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding FiltresResume}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Path Grid.Column="1"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="{DynamicResource TextPrimaryBrush}"
                                  Width="8" Height="4"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"/>
                          </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FiltreToggleBorder" Property="Background" Value="{DynamicResource ControlFillHoverBrush}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>

                  <Popup x:Name="FiltrePopup"
                         PlacementTarget="{Binding ElementName=FiltreToggle}"
                         Placement="Bottom"
                         IsOpen="{Binding IsChecked, ElementName=FiltreToggle, Mode=TwoWay}"
                         StaysOpen="False"
                         AllowsTransparency="True"
                         Focusable="False"
                         PopupAnimation="Slide">
                    <!--
                      DataContext explicite (cf. note ci-dessus) : celui de
                      FiltreToggle, PAS d'héritage implicite à travers le Popup.
                    -->
                    <Border DataContext="{Binding ElementName=FiltreToggle, Path=DataContext}"
                            Background="{DynamicResource ControlFillBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            MinWidth="180"
                            Padding="4"
                            SnapsToDevicePixels="True">
                      <ScrollViewer MaxHeight="220"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FiltresManuel}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <CheckBox Style="{DynamicResource CheckBoxStyle}"
                                        IsChecked="{Binding IsActif, Mode=TwoWay}"
                                        Content="{Binding Label}"
                                        Padding="6,4"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </Popup>
                </StackPanel>
              </Grid>

              <!--
                Compteur : plusieurs TextBlock/littéraux (pas de MultiBinding),
                calqué sur le badge de compte du mode « par jeu » (lignes 190-205).
                Plus de NbSelected (case de sélection de ligne retirée, cf.
                note sur la Grid des lignes de feuille ci-dessous).
              -->
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="{Binding NbFeuillesManuel}"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold"
                           FontSize="12.5"/>
                <TextBlock Text=" feuilles · "
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12.5"/>
                <TextBlock Text="{Binding NbPdf}"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold"
                           FontSize="12.5"/>
                <TextBlock Text=" PDF · "
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12.5"/>
                <TextBlock Text="{Binding NbDwg}"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold"
                           FontSize="12.5"/>
                <TextBlock Text=" DWG"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12.5"/>
              </StackPanel>

              <!--
                Liste des feuilles. ScrollViewer + ItemsControl, style carte
                (CardStyle) par ligne pour rester cohérent avec les cartes de
                collection du mode « par jeu ». Colonnes : case de sélection
                de ligne / Numero (90, mono) / [Nom + JeuNom + aperçu du nom
                empilés] (*) / tags PDF / DWG.
              -->
              <ScrollViewer Grid.Row="2"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding SheetsManuelFiltrees}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>

                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{DynamicResource CardStyle}"
                              Padding="12,10"
                              Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>

                          <!--
                            Ordre demandé : nom du jeu AVANT le numéro de feuille.
                            Pas de case de sélection de ligne : redondante avec
                            les interrupteurs PDF/DWG (une feuille sans format
                            actif n'est jamais exportée, cf. selection_manuelle()).
                          -->
                          <TextBlock Grid.Column="0"
                                     Text="{Binding JeuNom}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     Margin="0,0,8,0"/>

                          <TextBlock Grid.Column="1"
                                     Text="{Binding Numero}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontFamily="Consolas"
                                     FontSize="12.5"
                                     VerticalAlignment="Center"/>

                          <!--
                            Nom + aperçu du nom projeté empilés verticalement.
                          -->
                          <StackPanel Grid.Column="2"
                                      Orientation="Vertical"
                                      VerticalAlignment="Center"
                                      Margin="8,0">
                            <TextBlock Text="{Binding Nom}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12.5"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding NomProjete}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Consolas"
                                       FontStyle="Italic"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"/>
                          </StackPanel>

                          <CheckBox Grid.Column="3"
                                    Content="PDF"
                                    Style="{DynamicResource ToggleSwitchStyle}"
                                    IsChecked="{Binding ExportPdf, Mode=TwoWay}"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"/>

                          <CheckBox Grid.Column="4"
                                    Content="DWG"
                                    Style="{DynamicResource ToggleSwitchStyle}"
                                    IsChecked="{Binding ExportDwg, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>

            <!--
              Mode « Paramètres » (IsSettings) : réglages regroupés en
              3 Expanders REPLIABLES (IsExpanded="False" par défaut),
              stylés via CollectionExpanderStyle (socle Styles/StylesDark.xaml,
              déjà utilisé pour les cartes de collection en mode « par jeu »).

              - « Mappage des paramètres » : les 3 ComboBox Export/Carnet/DWG
                (inchangées, cf. ParamExport/ParamCarnet/ParamDwg).
              - « Setups d'impression » : les 2 ComboBox SetupPdf/SetupDwg
                (inchangées).
              - « Nommage des fichiers » : 2 boutons ouvrant la modale
                NamingEditorView (câblage Python, cf. wire_naming_editors
                dans MainWindowView).

              Sélection persistée par les setters ParamExport/ParamCarnet/
              ParamDwg (MainViewModel) qui déclenchent aussi refresh_par_jeu()
              -> les badges/qualification du mode « par jeu » se mettent à
              jour immédiatement au changement.
            -->
            <StackPanel Grid.Row="1"
                        x:Name="PanneauParametres"
                        Orientation="Vertical"
                        Margin="20,16,20,8"
                        Visibility="{Binding IsSettings, Converter={StaticResource BoolToVisibilityConverter}}">

              <!--
                Groupe 1 : Mappage des paramètres.
                Structure alignée sur la carte de collection (cf. CollectionCard
                ci-dessus) : Border CardStyle en conteneur EXTERIEUR, Expander
                CollectionExpanderStyle logé dedans. Le CardStyle porte déjà
                Margin="0,0,0,12" et Padding="16" — ne pas les redéfinir ici.
              -->
              <Border Style="{DynamicResource CardStyle}">
                <Expander Style="{DynamicResource CollectionExpanderStyle}"
                          IsExpanded="False">
                  <Expander.Header>
                    <TextBlock Text="Mappage des paramètres"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                  </Expander.Header>

                  <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                    <TextBlock Text="Choisissez, pour chaque rôle, le paramètre Oui/Non de collection qui qualifie les jeux."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Vertical">

                      <!-- Ligne Export -->
                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="140"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Export"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox Grid.Column="1"
                                  x:Name="ParamExportCombo"
                                  ItemsSource="{Binding ParametresDisponibles}"
                                  SelectedItem="{Binding ParamExport, Mode=TwoWay}"/>
                      </Grid>

                      <!-- Ligne Carnet -->
                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="140"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Carnet"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox Grid.Column="1"
                                  x:Name="ParamCarnetCombo"
                                  ItemsSource="{Binding ParametresDisponibles}"
                                  SelectedItem="{Binding ParamCarnet, Mode=TwoWay}"/>
                      </Grid>

                      <!-- Ligne DWG -->
                      <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="140"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="DWG"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox Grid.Column="1"
                                  x:Name="ParamDwgCombo"
                                  ItemsSource="{Binding ParametresDisponibles}"
                                  SelectedItem="{Binding ParamDwg, Mode=TwoWay}"/>
                      </Grid>

                    </StackPanel>
                  </StackPanel>
                </Expander>
              </Border>

              <!--
                Les 2 toggles d'organisation (sous-dossier par jeu / séparer
                PDF-DWG) ont été déplacés sous le champ destination, dans le
                footer (voir section « Sous-dossier et format » ci-dessous) :
                ils sont pertinents quel que soit le mode (Auto/Manuel), donc
                visibles en permanence plutôt qu'enfouis dans Paramètres.
              -->

              <!--
                Groupe 2 : Setups d'impression.
                Même structure « carte de collection » que le Groupe 1 :
                Border CardStyle en conteneur extérieur, Expander dedans.
              -->
              <Border Style="{DynamicResource CardStyle}">
                <Expander Style="{DynamicResource CollectionExpanderStyle}"
                          IsExpanded="False">
                  <Expander.Header>
                    <TextBlock Text="Setups d'impression"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                  </Expander.Header>

                  <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                    <TextBlock Text="Configurez les setups Revit utilisés pour l'export PDF et DWG."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Vertical">

                      <!-- Ligne Setup PDF -->
                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="140"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Setup PDF"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox Grid.Column="1"
                                  x:Name="SetupPdfCombo"
                                  ItemsSource="{Binding SetupsPdf}"
                                  SelectedItem="{Binding SetupPdf, Mode=TwoWay}"/>
                      </Grid>

                      <!-- Ligne Setup DWG -->
                      <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="140"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Setup DWG"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox Grid.Column="1"
                                  x:Name="SetupDwgCombo"
                                  ItemsSource="{Binding SetupsDwg}"
                                  SelectedItem="{Binding SetupDwg, Mode=TwoWay}"/>
                      </Grid>

                    </StackPanel>
                  </StackPanel>
                </Expander>
              </Border>

              <!--
                Groupe 3 : Nommage des fichiers. Ouvre la modale
                NamingEditorView (NamingEditorViewModel côté Python) pour
                éditer la convention de nommage des feuilles / des carnets.
                Câblage : MainWindowView.wire_naming_editors().

                Même structure « carte de collection » que les Groupes 1 et 2.
                Le CardStyle porte déjà Margin="0,0,0,12" ; comme pour les
                cartes de collection (dernier item de la liste inclus), on ne
                supprime pas cette marge basse pour rester cohérent.

                Les 2 anciens boutons pleine largeur ont été remplacés par
                2 lignes d'aperçu (motif courant, PatternFeuilleApercu /
                PatternCarnetApercu) + une icône d'édition compacte. Les
                x:Name="EditSheetNamingButton"/"EditSetNamingButton" sont
                CONSERVÉS sur ces icônes : MainWindowView.wire_naming_editors()
                les résout par FindName, seule l'apparence change (icône
                crayon au lieu du texte du bouton).
              -->
              <Border Style="{DynamicResource CardStyle}">
                <Expander Style="{DynamicResource CollectionExpanderStyle}"
                          IsExpanded="False">
                  <Expander.Header>
                    <TextBlock Text="Nommage des fichiers"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                  </Expander.Header>

                  <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                    <TextBlock Text="Éditez la convention de nommage utilisée pour renommer les fichiers exportés."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <!-- Ligne Feuille : label / aperçu du motif courant / icône d'édition -->
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0"
                                 Text="Feuille"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding PatternFeuilleApercu}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 FontFamily="Consolas"
                                 FontSize="12.5"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>
                      <Button Grid.Column="2"
                              x:Name="EditSheetNamingButton"
                              Content="&#x270E;"
                              ToolTip="Éditer le nommage des feuilles"
                              Width="32" Height="32"
                              Padding="0"
                              FontSize="14"
                              Style="{DynamicResource SecondaryActionButtonStyle}"/>
                    </Grid>

                    <!-- Ligne Carnet : label / aperçu du motif courant / icône d'édition -->
                    <Grid Margin="0,0,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0"
                                 Text="Carnet"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding PatternCarnetApercu}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 FontFamily="Consolas"
                                 FontSize="12.5"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>
                      <Button Grid.Column="2"
                              x:Name="EditSetNamingButton"
                              Content="&#x270E;"
                              ToolTip="Éditer le nommage des carnets"
                              Width="32" Height="32"
                              Padding="0"
                              FontSize="14"
                              Style="{DynamicResource SecondaryActionButtonStyle}"/>
                    </Grid>
                  </StackPanel>
                </Expander>
              </Border>

              <!--
                Groupe 4 : Profils (placeholder). Même structure « carte de
                collection » que les groupes précédents. Pas encore de VM
                dédié : simple TextBlock d'attente.
              -->
              <Border Style="{DynamicResource CardStyle}">
                <Expander Style="{DynamicResource CollectionExpanderStyle}"
                          IsExpanded="False">
                  <Expander.Header>
                    <TextBlock Text="Profils"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                  </Expander.Header>

                  <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                    <TextBlock Text="Gestion des profils d'export — à venir."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Expander>
              </Border>
            </StackPanel>

            <!--
              Footer d'actions. Masqué en mode Paramètres (IsNotSettings ->
              Collapsed) : la destination/les toggles/les boutons Parcourir/
              Exporter ne concernent que les modes « par jeu » et « feuille
              par feuille ».

              Disposition (haut -> bas) :
                (a) TextBox destination pleine largeur (éditable, TwoWay) ;
                (b) une ligne [toggles « Sous-dossier et format » à gauche]
                    .... [StatusText discret] [Parcourir…] [Exporter] à droite.
            -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,14"
                    Visibility="{Binding IsNotSettings, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel Orientation="Vertical">

                <!--
                  Dossier de destination courant (Task « Parcourir »).
                  TextBox pleine largeur, éditable directement : le bouton
                  « Parcourir… » reste un raccourci vers l'explorateur, mais
                  l'utilisateur peut aussi coller/taper le chemin ici.
                  UpdateSourceTrigger=LostFocus : on ne persiste/ne
                  requalifie qu'une fois la saisie terminée (pas à chaque
                  frappe), cohérent avec le coût de `definir_destination`
                  (I/O disque possible via `ensure`).
                -->
                <TextBox Text="{Binding DestinationPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Margin="0,0,0,12"/>

                <!-- Ligne basse : toggles à gauche, actions à droite -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!--
                    Sous-dossier et format : les 2 interrupteurs d'organisation
                    de l'export (déplacés depuis Paramètres, cf. carte
                    « Options d'export »), regroupés sous le champ destination
                    car pertinents quel que soit le mode (Auto/Manuel).
                  -->
                  <StackPanel Grid.Column="0"
                              Orientation="Vertical"
                              VerticalAlignment="Center">
                    <TextBlock Text="Organisation de l'export"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <!-- Mode « par jeu » : sous-dossier par jeu + séparation formats -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibilityConverter}}">
                      <CheckBox Content="Sous-dossier par jeu"
                                Style="{DynamicResource ToggleSwitchStyle}"
                                IsChecked="{Binding CreerSousDossiers, Mode=TwoWay}"
                                Margin="0,4,20,4"/>
                      <CheckBox Content="Séparer PDF / DWG"
                                Style="{DynamicResource ToggleSwitchStyle}"
                                IsChecked="{Binding SeparerFormats, Mode=TwoWay}"
                                Margin="0,4"/>
                    </StackPanel>

                    <!-- Mode « feuille par feuille » : PDF combiné (+ titre) + séparation formats.
                         Le champ titre n'est éditable que si « Combiné » est actif
                         (IsEnabled lié à CombinerPdf). -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibilityConverter}}">
                      <CheckBox Content="Combiné"
                                Style="{DynamicResource ToggleSwitchStyle}"
                                IsChecked="{Binding CombinerPdf, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="0,4,12,4"/>
                      <TextBox Text="{Binding TitrePdfCombine, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               IsEnabled="{Binding CombinerPdf}"
                               Width="200"
                               VerticalAlignment="Center"
                               ToolTip="Titre du PDF combiné"
                               Margin="0,4,20,4"/>
                      <CheckBox Content="Séparer PDF / DWG"
                                Style="{DynamicResource ToggleSwitchStyle}"
                                IsChecked="{Binding SeparerFormats, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="0,4"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- Retour visuel export (Task 3) : StatusText, discret,
                       aligné avec les boutons à droite. Mis à jour via
                       progress_cb/log_cb de ExportOrchestrator. -->
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock"
                               Text="{Binding StatusText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               MaxWidth="180"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button x:Name="SecondaryActionButton"
                            Content="Parcourir…"
                            Style="{DynamicResource SecondaryActionButtonStyle}"
                            Margin="0,0,10,0"/>
                    <Button x:Name="PrimaryActionButton"
                            Content="Exporter"
                            Style="{DynamicResource PrimaryActionButtonStyle}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
