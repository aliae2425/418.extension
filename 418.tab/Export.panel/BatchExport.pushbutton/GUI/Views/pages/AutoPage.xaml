<!--
  SPIKE (étape 0) : page « par jeu » extraite du MainWindow.xaml.
  Chargée séparément via XamlReader et insérée dans le ContentControl
  AutoPageHost du shell. DataContext = AutoPageVM (fixé en code).

  Aucune StaticResource ici (la Visibility IsAuto est portée par l'hôte
  dans le shell) -> pas besoin du BoolToVisibilityConverter. Tout le reste
  est en DynamicResource, résolu en remontant l'arbre une fois inséré dans
  la fenêtre (dictionnaires de thème déjà fusionnés par UIResourceLoader).
-->
<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
  <ItemsControl ItemsSource="{Binding Collections}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Vertical"/>
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>

    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Border Style="{DynamicResource CardStyle}"
                x:Name="CollectionCard">
          <Expander Style="{DynamicResource CollectionExpanderStyle}"
                    IsExpanded="False">
            <Expander.Header>
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding Titre}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontWeight="SemiBold"
                             FontSize="14"/>

                  <!--
                    Aperçu du titre de carnet : icône livre + nom de fichier
                    PDF résolu (motif `set`). Visible uniquement si le carnet
                    est actif ET l'aperçu non vide (CarnetApercuVisible),
                    basculé par un DataTrigger ci-dessous — cette page n'a pas
                    de BoolToVisibilityConverter (patron identique aux badges).
                  -->
                  <StackPanel x:Name="CarnetApercuLine"
                              Orientation="Horizontal"
                              Visibility="Collapsed"
                              Margin="0,2,0,0">
                    <TextBlock Text="&#x1F4D6;"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CarnetApercu}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                  <Border x:Name="BadgeExport"
                          Background="{DynamicResource ControlFillBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="8,3"
                          Margin="4,0,0,0">
                    <TextBlock x:Name="BadgeExportText"
                               Text="EXPORT"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDisabledBrush}"/>
                  </Border>

                  <Border x:Name="BadgeCarnet"
                          Background="{DynamicResource ControlFillBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="8,3"
                          Margin="4,0,0,0">
                    <TextBlock x:Name="BadgeCarnetText"
                               Text="CARNET"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDisabledBrush}"/>
                  </Border>

                  <Border x:Name="BadgeDwg"
                          Background="{DynamicResource ControlFillBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="8,3"
                          Margin="4,0,0,0">
                    <TextBlock x:Name="BadgeDwgText"
                               Text="DWG"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDisabledBrush}"/>
                  </Border>
                </StackPanel>
              </Grid>
            </Expander.Header>

            <ItemsControl ItemsSource="{Binding Sheets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Numero}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Nom}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12.5"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding NomProjete}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5"
                               FontStyle="Italic"
                               TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </Border>

        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Qualified}" Value="False">
            <Setter TargetName="CollectionCard" Property="Opacity" Value="0.5"/>
          </DataTrigger>

          <!-- Aperçu du titre de carnet : visible seulement si carnet actif
               ET aperçu non vide (cf. CollectionItemVM.CarnetApercuVisible). -->
          <DataTrigger Binding="{Binding CarnetApercuVisible}" Value="True">
            <Setter TargetName="CarnetApercuLine" Property="Visibility" Value="Visible"/>
          </DataTrigger>

          <DataTrigger Binding="{Binding FlagExport}" Value="True">
            <Setter TargetName="BadgeExport" Property="Background" Value="{DynamicResource SuccessBrush}"/>
            <Setter TargetName="BadgeExport" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
            <Setter TargetName="BadgeExportText" Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
          </DataTrigger>

          <DataTrigger Binding="{Binding FlagCarnet}" Value="True">
            <Setter TargetName="BadgeCarnet" Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter TargetName="BadgeCarnet" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter TargetName="BadgeCarnetText" Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
          </DataTrigger>

          <DataTrigger Binding="{Binding FlagDwg}" Value="True">
            <Setter TargetName="BadgeDwg" Property="Background" Value="{DynamicResource WarningBrush}"/>
            <Setter TargetName="BadgeDwg" Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
            <Setter TargetName="BadgeDwgText" Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</ScrollViewer>
