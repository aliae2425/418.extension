<!--
  Page du mode « Par jeu » : liste des jeux (Collections), un par carte.

  Les 3 badges EXPORT / CARNET / DWG sont des ToggleButton CLIQUABLES,
  bindés TwoWay sur FlagExport / FlagCarnet / FlagDwg.

  L'état de ces 3 flags vit UNIQUEMENT en mémoire : il n'est jamais écrit
  dans les paramètres Revit. C'est la raison d'être du mode — quand la
  maquette est partagée, les paramètres Oui/Non des jeux ne sont pas
  éditables, on pilote donc l'export depuis ici.

  Chargée séparément via XamlReader et insérée dans le ContentControl
  JeuxPageHost du shell. DataContext = MainViewModel (fixé en code).
  Pas de x:Class, pas de code-behind, pas de handler déclaré en XAML.

  Seule StaticResource tolérée : BadgeToggleTemplate, défini juste en
  dessous dans CETTE page. Tout le thème est en DynamicResource, résolu en
  remontant l'arbre une fois la page insérée dans la fenêtre.
-->
<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

  <ScrollViewer.Resources>
    <!--
      Gabarit unique des 3 badges cliquables.

      La couleur « allumée » n'est pas codée ici : c'est le Background posé
      sur chaque ToggleButton (SuccessBrush / AccentBrush / WarningBrush),
      repris tel quel par le Border via TemplateBinding. Seul l'état DÉCOCHÉ
      est surchargé par un Trigger — ainsi aucun Binding dans un Setter.

      Note d'imbrication : l'en-tête d'Expander du socle
      (CollectionExpanderStyle) est lui-même un ToggleButton. Un ToggleButton
      imbriqué marque MouseLeftButtonDown comme traité (ButtonBase), donc un
      clic sur un badge NE replie PAS la carte — le comportement voulu.
    -->
    <ControlTemplate x:Key="BadgeToggleTemplate" TargetType="ToggleButton">
      <Border x:Name="BadgeBorder"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding Background}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="8,3">
        <TextBlock x:Name="BadgeText"
                   Text="{TemplateBinding Content}"
                   FontSize="10.5"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextOnAccentBrush}"/>
      </Border>
      <ControlTemplate.Triggers>
        <!-- Décoché : badge éteint (fond neutre, texte grisé). -->
        <Trigger Property="IsChecked" Value="False">
          <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource ControlFillBrush}"/>
          <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
          <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
        </Trigger>
        <!-- Affordance de clic. -->
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="BadgeBorder" Property="Opacity" Value="0.75"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </ScrollViewer.Resources>

  <ItemsControl ItemsSource="{Binding Collections}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Vertical"/>
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>

    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Border Style="{DynamicResource CardStyle}"
                x:Name="CollectionCard">
          <Expander Style="{DynamicResource CollectionExpanderStyle}"
                    IsExpanded="False">
            <Expander.Header>
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding Titre}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontWeight="SemiBold"
                             FontSize="14"/>

                  <!--
                    Aperçu du titre de carnet : icône livre + nom de fichier
                    PDF résolu (motif `set`). Visible uniquement si le carnet
                    est actif ET l'aperçu non vide (CarnetApercuVisible),
                    basculé par un DataTrigger ci-dessous — cette page n'a pas
                    de BoolToVisibilityConverter.
                  -->
                  <StackPanel x:Name="CarnetApercuLine"
                              Orientation="Horizontal"
                              Visibility="Collapsed"
                              Margin="0,2,0,0">
                    <TextBlock Text="&#x1F4D6;"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CarnetApercu}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                  <ToggleButton x:Name="BadgeExport"
                                Content="EXPORT"
                                ToolTip="Inclure ce jeu dans l'export (mémoire seule)"
                                Template="{StaticResource BadgeToggleTemplate}"
                                Background="{DynamicResource SuccessBrush}"
                                IsChecked="{Binding FlagExport, Mode=TwoWay}"
                                Cursor="Hand"
                                Focusable="False"
                                Margin="4,0,0,0"/>

                  <ToggleButton x:Name="BadgeCarnet"
                                Content="CARNET"
                                ToolTip="Assembler ce jeu en carnet PDF (mémoire seule)"
                                Template="{StaticResource BadgeToggleTemplate}"
                                Background="{DynamicResource AccentBrush}"
                                IsChecked="{Binding FlagCarnet, Mode=TwoWay}"
                                Cursor="Hand"
                                Focusable="False"
                                Margin="4,0,0,0"/>

                  <ToggleButton x:Name="BadgeDwg"
                                Content="DWG"
                                ToolTip="Exporter aussi ce jeu en DWG (mémoire seule)"
                                Template="{StaticResource BadgeToggleTemplate}"
                                Background="{DynamicResource WarningBrush}"
                                IsChecked="{Binding FlagDwg, Mode=TwoWay}"
                                Cursor="Hand"
                                Focusable="False"
                                Margin="4,0,0,0"/>
                </StackPanel>
              </Grid>
            </Expander.Header>

            <ItemsControl ItemsSource="{Binding Sheets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Numero}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Nom}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12.5"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding NomProjete}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5"
                               FontStyle="Italic"
                               TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </Border>

        <DataTemplate.Triggers>
          <!-- Suit les clics : FlagExport notifie Qualified. -->
          <DataTrigger Binding="{Binding Qualified}" Value="False">
            <Setter TargetName="CollectionCard" Property="Opacity" Value="0.5"/>
          </DataTrigger>

          <!-- Aperçu du titre de carnet : visible seulement si carnet actif
               ET aperçu non vide (cf. CollectionItemVM.CarnetApercuVisible). -->
          <DataTrigger Binding="{Binding CarnetApercuVisible}" Value="True">
            <Setter TargetName="CarnetApercuLine" Property="Visibility" Value="Visible"/>
          </DataTrigger>

          <!-- Pas de trigger de coloration des badges ici : c'est
               BadgeToggleTemplate qui porte les deux états. -->
        </DataTemplate.Triggers>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</ScrollViewer>
