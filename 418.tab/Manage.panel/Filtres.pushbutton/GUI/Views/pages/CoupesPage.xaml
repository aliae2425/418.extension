<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Onglet Coupes - le rep&#233;rage, coupe par coupe. DataContext = CoupesPageVM.
    XamlReader.Load, pas de x:Class : brushes et styles en DynamicResource.

    Une carte par coupe, d&#233;pliable ; dedans, ses r&#232;gles. Les trois &#233;diteurs
    de cible d'une r&#232;gle sont TOUS pos&#233;s, et un DataTrigger sur `Mode`
    (cl&#233; ASCII, pas le libell&#233; affich&#233;) n'en montre qu'un.

    Seul x:Name &#224; c&#226;bler : AppliquerButton (RailWindow.RUN). Tout le reste
    passe par des Command du ViewModel.
  -->

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- titre + r&#233;sum&#233; -->
      <RowDefinition Height="Auto"/>   <!-- r&#233;glage du type de vue -->
      <RowDefinition Height="*"/>      <!-- les coupes -->
      <RowDefinition Height="Auto"/>   <!-- action -->
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="{Binding TitrePage}"
                 Style="{DynamicResource HeaderTextBlockStyle}"/>
      <TextBlock Text="{Binding Resume}"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 FontSize="11"
                 Margin="0,2,0,0"/>
    </StackPanel>

    <!-- ============ Quel type de vue est un plan de rep&#233;rage ============
         R&#233;glage m&#233;moris&#233; (UserConfig) : il d&#233;signe d'un coup tous les PDR
         du projet, sans rien cocher vue par vue. -->
    <Border Grid.Row="1"
            Style="{DynamicResource CardStyle}"
            Padding="14,12" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="Type de vue des plans de rep&#233;rage"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <ComboBox ItemsSource="{Binding Types}"
                  DisplayMemberPath="Nom"
                  SelectedItem="{Binding TypeChoisi, Mode=TwoWay}"
                  Margin="0,6,0,0"/>
        <TextBlock Text="Tant qu'aucun type n'est choisi, l'outil ne voit aucun plan de rep&#233;rage et n'&#233;crit rien."
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Foreground="{DynamicResource WarningBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding AucunPlan}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- ============ Une carte par coupe ============ -->
    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Lignes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,6">
              <Expander Style="{DynamicResource CollectionExpanderStyle}">

                <Expander.Header>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Nom}"
                                 FontSize="13" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Nom}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock Text="{Binding Origine}"
                                 FontSize="10"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding TypeVue}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="12,0,12,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Resume}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                </Expander.Header>

                <StackPanel Margin="0,10,0,0">

                  <!-- les r&#232;gles de cette coupe -->
                  <ItemsControl ItemsSource="{Binding Regles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Background="{DynamicResource TransparentBrush}"
                                Padding="0,8">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="150"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Modes}"
                                      DisplayMemberPath="Libelle"
                                      SelectedItem="{Binding ModeChoisi, Mode=TwoWay}"
                                      VerticalAlignment="Top"
                                      Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1">

                              <!-- cible : un jeu de feuilles -->
                              <ComboBox ItemsSource="{Binding Jeux}"
                                        SelectedItem="{Binding JeuChoisi, Mode=TwoWay}">
                                <ComboBox.Style>
                                  <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Mode}" Value="jeu">
                                        <Setter Property="Visibility" Value="Visible"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </ComboBox.Style>
                              </ComboBox>

                              <!-- cible : UN plan de rep&#233;rage -->
                              <ComboBox ItemsSource="{Binding Plans}"
                                        SelectedItem="{Binding PlanChoisi, Mode=TwoWay}">
                                <ComboBox.Style>
                                  <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Mode}" Value="plan">
                                        <Setter Property="Visibility" Value="Visible"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </ComboBox.Style>
                              </ComboBox>

                              <!-- cible : plusieurs plans, coch&#233;s -->
                              <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Padding="8,6"
                                      MaxHeight="112">
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Mode}" Value="specifique">
                                        <Setter Property="Visibility" Value="Visible"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                  <ItemsControl ItemsSource="{Binding Cibles}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <WrapPanel/>
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <CheckBox Style="{DynamicResource CheckBoxStyle}"
                                                  Content="{Binding Nom}"
                                                  IsChecked="{Binding Coche, Mode=TwoWay}"
                                                  Margin="0,2,16,2"/>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </ScrollViewer>
                              </Border>

                              <TextBlock Text="{Binding Resume}"
                                         FontSize="10"
                                         TextTrimming="CharacterEllipsis"
                                         Margin="0,4,0,0"
                                         ToolTip="{Binding Resume}"
                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="Retirer"
                                    Command="{Binding Retirer}"
                                    Style="{DynamicResource SecondaryActionButtonStyle}"
                                    VerticalAlignment="Top"
                                    Margin="10,0,0,0"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- pas de r&#232;gle = aucune contrainte -->
                  <TextBlock Text="Aucune r&#232;gle : le rep&#232;re de cette coupe reste visible sur tous les plans de rep&#233;rage."
                             FontSize="11"
                             TextWrapping="Wrap"
                             Margin="0,4,0,0"
                             Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ARegles}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>

                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Ajouter une r&#232;gle"
                            Command="{Binding Ajouter}"
                            Style="{DynamicResource SecondaryActionButtonStyle}"/>
                    <Button Content="Tout retirer"
                            Command="{Binding Effacer}"
                            Style="{DynamicResource SecondaryActionButtonStyle}"
                            Margin="8,0,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Expander>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- ============ Action ============ -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="Un filtre 418_PDR_S&lt;feuille&gt; par plan de rep&#233;rage : il masque les rep&#232;res des coupes qui ne s'y montrent pas."
                 FontSize="11"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 Margin="0,0,12,0"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>

      <Button Grid.Column="1"
              x:Name="AppliquerButton"
              Content="Appliquer le rep&#233;rage"
              Style="{DynamicResource PrimaryActionButtonStyle}"/>
    </Grid>
  </Grid>
</UserControl>
