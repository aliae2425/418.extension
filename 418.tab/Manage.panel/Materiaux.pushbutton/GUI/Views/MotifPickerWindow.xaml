<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titre}"
        Width="620" Height="640"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{DynamicResource TransparentBrush}"
        WindowStartupLocation="CenterOwner">

  <!--
    Modale « choisir un motif » — DataContext = MotifPickerVM.

    Chargée par BaseWindow via XamlReader.Load : PAS de x:Class, PAS de
    code-behind, tout brush/style de thème en DynamicResource.

    MotifsList et ChoisirButton sont câblés par MotifPickerWindowView : le
    double-clic vaut validation, et Choisir ne ferme que si une ligne est
    sélectionnée.
  -->

  <Border CornerRadius="8"
          Background="{DynamicResource WindowBackgroundBrush}"
          BorderBrush="{DynamicResource ControlBorderBrush}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- barre de titre -->
        <RowDefinition Height="Auto"/>   <!-- recherche -->
        <RowDefinition Height="*"/>      <!-- liste -->
        <RowDefinition Height="Auto"/>   <!-- actions -->
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" x:Name="TitleBar"
            Background="{DynamicResource TransparentBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding Titre}"
                   Style="{DynamicResource HeaderTextBlockStyle}"
                   Margin="20,0,0,0"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1"
                x:Name="CloseButton"
                Content="✕"
                Width="40" Height="40"
                Margin="0,4,4,0"
                VerticalAlignment="Top"
                Style="{DynamicResource CaptionCloseButtonStyle}"/>
      </Grid>

      <Grid Grid.Row="1" Margin="20,6,20,10">
        <TextBox x:Name="SearchBox"
                 Text="{Binding Recherche, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <!-- Filigrane : le gabarit TextBox du socle n'a pas de watermark, un
             TextBlock posé par-dessus et masqué dès qu'on tape fait le même
             travail sans convertisseur. -->
        <TextBlock Text="Rechercher — nom, « modèle », « dessin »…"
                   FontSize="12"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource TextDisabledBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Recherche}" Value="">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <ListBox Grid.Row="2"
               x:Name="MotifsList"
               Margin="20,0,20,0"
               ItemsSource="{Binding MotifsFiltres}"
               SelectedItem="{Binding Selection, Mode=TwoWay}"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <!-- Fond blanc en dur : c'est du papier, pas du thème. Une
                   hachure noire doit rester lisible en mode sombre. -->
              <Border Width="120" Height="26" CornerRadius="3"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      Background="White"
                      ClipToBounds="True">
                <Image Source="{Binding Apercu}" Stretch="None"/>
              </Border>
              <TextBlock Grid.Column="1"
                         Text="{Binding Nom}"
                         VerticalAlignment="Center"
                         Margin="12,0,12,0"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Nom}"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Grid.Column="2"
                         Text="{Binding Type}"
                         FontSize="10"
                         VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding EstModele}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Row="3" Margin="20,12,20,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="Double-cliquez une ligne pour valider directement."
                   FontSize="11"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextDisabledBrush}"/>
        <Button Grid.Column="1"
                x:Name="AnnulerButton"
                Content="Annuler"
                IsCancel="True"
                Style="{DynamicResource SecondaryActionButtonStyle}"
                Margin="0,0,10,0"/>
        <Button Grid.Column="2"
                x:Name="ChoisirButton"
                Content="Choisir"
                IsDefault="True"
                Style="{DynamicResource PrimaryActionButtonStyle}"/>
      </Grid>
    </Grid>
  </Border>
</Window>
