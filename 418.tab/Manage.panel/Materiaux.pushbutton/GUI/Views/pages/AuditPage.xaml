<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Onglet 0 — audit des matériaux. DataContext = AuditPageVM. Chargée via
    XamlReader.Load (PAS de x:Class, PAS de code-behind) : brushes et styles
    en DynamicResource.

    C'est l'onglet ouvert par défaut : le premier de MainWindowView.ONGLETS et
    le mode initial de MainViewModel. Page en LECTURE SEULE — aucun x:Name à
    câbler, aucun bouton. Les chiffres viennent des MaterialCardVM déjà
    construites (aucune requête Revit de plus).

    Une seule tuile pour tous les indicateurs : IndicateurVM porte le chiffre,
    le libellé, le détail et le drapeau Alerte, qui teinte le chiffre. Ajouter
    un indicateur se fait dans AuditPageVM.calculer(), pas ici.

    Les deux sections de détail (apparences partagées, noms proches) se
    replient quand elles sont vides.
  -->

  <UserControl.Resources>
    <Style x:Key="SectionTitreStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,18,0,6"/>
    </Style>

    <!-- Pastille du nombre de membres d'un groupe. -->
    <Style x:Key="PastilleStyle" TargetType="Border">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource TransparentBrush}" Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- titre -->
      <RowDefinition Height="Auto"/>   <!-- résumé -->
      <RowDefinition Height="*"/>      <!-- tuiles + détails -->
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="{Binding TitrePage}"
               Style="{DynamicResource HeaderTextBlockStyle}"/>

    <TextBlock Grid.Row="1"
               Text="{Binding Resume}"
               FontSize="11"
               Margin="0,2,0,12"
               Foreground="{DynamicResource TextSecondaryBrush}"/>

    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <!-- ═══════════ Récap : anneau + score ═══════════
             L'anneau est une DrawingImage construite par views/donut_image.py
             (pas de dessin en XAML) : les trois parts SONT une partition du
             modèle, un matériau ne tombe que dans une. Le score au centre est
             noté par AuditPageVM.BAREME.

             Les pastilles de légende sont bindées en '#RRGGBB' plutôt qu'en
             DynamicResource : c'est la MÊME teinte que celle tracée dans
             l'anneau, elle vient du même endroit (SegmentVM.Couleur). -->
        <Border Style="{DynamicResource CardStyle}"
                Padding="18,16" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="24"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="140" Height="140">
              <Image Source="{Binding Torus}"
                     Width="140" Height="140"
                     Stretch="Uniform"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Score}"
                           FontSize="34"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                      <Style.Triggers>
                        <!-- Sur ScoreNiveau (ASCII), pas sur la mention
                             affichée : la couleur ne doit pas dépendre d'un
                             libellé accentué. -->
                        <DataTrigger Binding="{Binding ScoreNiveau}" Value="bon">
                          <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ScoreNiveau}" Value="moyen">
                          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ScoreNiveau}" Value="critique">
                          <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="sur 100"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,-4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding ScoreMention}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Text="{Binding ScoreDetail}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,1,0,10"
                         ToolTip="Points retirés par poste : non utilisés (50 max), doublons (35 max), fiches sans classe ni apparence (15 max)."
                         Foreground="{DynamicResource TextSecondaryBrush}"/>

              <ItemsControl ItemsSource="{Binding Segments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="52"/>
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0"
                              Width="12" Height="12" CornerRadius="3"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Background="{Binding Couleur}"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Libelle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Detail}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2"
                                 Text="{Binding Valeur}"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock Grid.Column="3"
                                 Text="{Binding Part}"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 TextAlignment="Right"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ═══════════ Tuiles ═══════════
             4 par rangée : 220 de tuile + 12 de gouttière = 928 pour la zone
             de page à 1040 de fenêtre (cf. MainWindowView.TAILLE). -->
        <ItemsControl ItemsSource="{Binding Indicateurs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{DynamicResource CardStyle}"
                      Width="220" Padding="14,12" Margin="0,0,12,12">
                <StackPanel>
                  <TextBlock Text="{Binding Valeur}"
                             FontSize="30"
                             FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Style.Triggers>
                          <!-- Il y a quelque chose à faire : chiffre teinté. -->
                          <DataTrigger Binding="{Binding Alerte}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding Libelle}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"
                             Margin="0,2,0,0"
                             ToolTip="{Binding Libelle}"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <TextBlock Text="{Binding Detail}"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Margin="0,1,0,0"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══════════ Rien à signaler ═══════════ -->
        <TextBlock Text="Aucun doublon d'apparence ni de nom : rien à fusionner."
                   FontSize="12"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource SuccessBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ARienASignaler}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- ═══════════ Apparences partagées ═══════════ -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding AApparencesPartagees}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <TextBlock Text="Apparences partagées par plusieurs matériaux"
                     Style="{StaticResource SectionTitreStyle}"/>
          <TextBlock Text="Même asset de rendu, donc même aspect en vue réaliste. Souvent des matériaux à fusionner dans l'onglet Remplacer."
                     FontSize="11"
                     TextWrapping="Wrap"
                     Margin="0,0,0,6"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>

          <ItemsControl ItemsSource="{Binding ApparencesPartagees}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Background="{DynamicResource TransparentBrush}"
                        Padding="2,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="240"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PastilleStyle}">
                      <TextBlock Text="{Binding Nombre}"
                                 FontSize="11"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Titre}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               ToolTip="{Binding Titre}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Membres}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               ToolTip="{Binding Membres}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ═══════════ Noms proches ═══════════ -->
        <StackPanel Margin="0,0,0,10">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ANomsProches}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <TextBlock Text="Noms proches"
                     Style="{StaticResource SectionTitreStyle}"/>
          <TextBlock Text="Noms identiques à la casse, aux accents, à la ponctuation ou à un « (1) » près."
                     FontSize="11"
                     TextWrapping="Wrap"
                     Margin="0,0,0,6"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>

          <ItemsControl ItemsSource="{Binding NomsProches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Background="{DynamicResource TransparentBrush}"
                        Padding="2,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PastilleStyle}">
                      <TextBlock Text="{Binding Nombre}"
                                 FontSize="11"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Membres}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               ToolTip="{Binding Membres}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
