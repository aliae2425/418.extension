<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Onglet 3 — remplacer les AFFECTATIONS de matériau dans la maquette.
    DataContext = RemplacerPageVM. Chargée via XamlReader.Load (PAS de
    x:Class, PAS de code-behind) : brushes et styles en DynamicResource.

    LES DEUX SÉLECTIONS SONT SUR CETTE PAGE, dans le MÊME tableau :
      - la case à gauche  -> matériau SOURCE (plusieurs possibles)
      - le rond à côté    -> matériau CIBLE (un seul, exclusif)
    Le tableau est alimenté par {Binding SelectionVM.FilteredItems}, c'est-à-
    dire la MÊME SelectionPageVM que l'onglet Matériaux : cocher ici coche la
    card là-bas. Les vignettes de motif sont celles des cards, en plus petit.

    Câblage (MainWindowView._wire_liste_remplacer) :
      - SourcesList : un handler unique de clic de ligne -> bascule la source,
        sauf si le clic a atterri dans le rond de cible.
      - le rond : handler de RadioButton.CheckedEvent posé sur la liste, donc
        un seul handler pour toutes les lignes (pas de x:Name dans un
        DataTemplate).
      - SelectAllButton / DeselectAllButton : Tout / Aucun.

    Pas de convertisseur bool -> Visibility dans le socle : les blocs
    conditionnels passent par un DataTrigger sur un Style local.
  -->

  <Grid Background="{DynamicResource TransparentBrush}" Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="20"/>
      <ColumnDefinition Width="290"/>
    </Grid.ColumnDefinitions>

    <!-- ═══════════ Colonne gauche : le tableau ═══════════ -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- titre -->
        <RowDefinition Height="Auto"/>   <!-- recherche -->
        <RowDefinition Height="Auto"/>   <!-- en-têtes -->
        <RowDefinition Height="*"/>      <!-- lignes -->
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 Text="Remplacer dans la maquette"
                 Style="{DynamicResource HeaderTextBlockStyle}"
                 Margin="0,0,0,14"/>

      <Grid Grid.Row="1" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0"
                 x:Name="SearchBox"
                 Text="{Binding SelectionVM.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Grid.Column="1" x:Name="SelectAllButton" Content="Tout"
                Style="{DynamicResource SecondaryActionButtonStyle}" Margin="8,0,0,0"/>
        <Button Grid.Column="2" x:Name="DeselectAllButton" Content="Aucun"
                Style="{DynamicResource SecondaryActionButtonStyle}" Margin="8,0,0,0"/>
      </Grid>

      <!-- En-têtes : mêmes largeurs que le DataTemplate ci-dessous -->
      <Border Grid.Row="2"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="2,0,2,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="46"/>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="src" FontSize="10"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Grid.Column="1" Text="cible" FontSize="10"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Grid.Column="2" Text="app." FontSize="10"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Grid.Column="3" Text="coupe" FontSize="10"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Grid.Column="4" Text="surface" FontSize="10"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Grid.Column="5" Text="nom" FontSize="10"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Grid.Column="6" Text="classe" FontSize="10"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="3"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="SourcesList"
                      ItemsSource="{Binding SelectionVM.FilteredItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="2,4">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource TransparentBrush}"/>
                    <Style.Triggers>
                      <!-- La cible se distingue de la sélection source -->
                      <DataTrigger Binding="{Binding EstCible}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                  </Grid.ColumnDefinitions>

                  <!-- Source : display-only, tous les clics passent par la
                       ligne (évite le double déclenchement) -->
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding IsSelected, Mode=OneWay}"
                            IsHitTestVisible="False"
                            Style="{DynamicResource CheckBoxStyle}"
                            VerticalAlignment="Center"/>

                  <!-- Cible : cliquable, exclusif. GroupName partagé pour que
                       WPF éteigne le précédent tout seul. -->
                  <RadioButton Grid.Column="1"
                               GroupName="cible"
                               IsChecked="{Binding EstCible, Mode=OneWay}"
                               VerticalAlignment="Center"
                               ToolTip="Prendre ce matériau comme cible"/>

                  <Border Grid.Column="2" Width="40" Height="24" CornerRadius="3"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          Background="{Binding ApparenceCouleur}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"/>

                  <Border Grid.Column="3" Width="64" Height="26" CornerRadius="3"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          Background="{DynamicResource ControlFillBrush}"
                          ClipToBounds="True"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          ToolTip="{Binding MotifCoupeNom}">
                    <Image Source="{Binding MotifCoupeImage}" Stretch="UniformToFill"/>
                  </Border>

                  <Border Grid.Column="4" Width="64" Height="26" CornerRadius="3"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          Background="{DynamicResource ControlFillBrush}"
                          ClipToBounds="True"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          ToolTip="{Binding MotifSurfaceNom}">
                    <Image Source="{Binding MotifSurfaceImage}" Stretch="UniformToFill"/>
                  </Border>

                  <TextBlock Grid.Column="5"
                             Text="{Binding Nom}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>

                  <TextBlock Grid.Column="6"
                             Text="{Binding Classe}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- ═══════════ Colonne droite : action et rapport ═══════════ -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- sources -->
        <RowDefinition Height="Auto"/>   <!-- cible -->
        <RowDefinition Height="Auto"/>   <!-- boutons -->
        <RowDefinition Height="Auto"/>   <!-- état -->
        <RowDefinition Height="*"/>      <!-- rapport -->
        <RowDefinition Height="Auto"/>   <!-- peinture -->
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 Text="{Binding SourcesResume}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Margin="0,52,0,8"/>

      <TextBlock Grid.Row="1"
                 Text="{Binding CibleResume}"
                 FontSize="12"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Margin="0,0,0,14"/>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
        <Button x:Name="AnalyserButton"
                Content="Analyser"
                Style="{DynamicResource SecondaryActionButtonStyle}"
                IsEnabled="{Binding PeutAnalyser}"/>
        <Button x:Name="RemplacerButton"
                Content="Remplacer"
                Style="{DynamicResource PrimaryActionButtonStyle}"
                IsEnabled="{Binding PeutRemplacer}"
                Margin="10,0,0,0"/>
      </StackPanel>

      <TextBlock Grid.Row="3"
                 Text="{Binding Etat}"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Margin="0,0,0,10"/>

      <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Lignes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="2,7">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             Text="{Binding Categorie}"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding Detail}"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Grid.Row="5"
                 Text="{Binding AvertissementPeints}"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource WarningBrush}"
                 Margin="0,10,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasPeints}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </Grid>
</UserControl>
