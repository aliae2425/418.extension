<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Onglet 2 — renommage en masse des matériaux cochés.
    DataContext = RenommerPageVM. Chargée via XamlReader.Load (PAS de
    x:Class, PAS de code-behind) : brushes et styles en DynamicResource.

    Les quatre champs sont en UpdateSourceTrigger=PropertyChanged : l'aperçu
    se recalcule à la frappe. RenommerButton est câblé par MainWindowView.
    Les lignes inchangées s'affichent en gris (DataTrigger sur Change).
  -->

  <Grid Background="{DynamicResource TransparentBrush}" Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- titre -->
      <RowDefinition Height="Auto"/>   <!-- champs -->
      <RowDefinition Height="Auto"/>   <!-- erreur regex -->
      <RowDefinition Height="*"/>      <!-- aperçu -->
      <RowDefinition Height="Auto"/>   <!-- action + état -->
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Renommer les matériaux"
               Style="{DynamicResource HeaderTextBlockStyle}"
               Margin="0,0,0,14"/>

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="Rechercher"
                 FontSize="11" Margin="0,0,0,4"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
      <TextBox Grid.Row="1" Grid.Column="0"
               Text="{Binding Rechercher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

      <TextBlock Grid.Row="0" Grid.Column="2" Text="Remplacer par"
                 FontSize="11" Margin="0,0,0,4"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
      <TextBox Grid.Row="1" Grid.Column="2"
               Text="{Binding Remplacer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Préfixe"
                 FontSize="11" Margin="0,10,0,4"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
      <TextBox Grid.Row="3" Grid.Column="0"
               Text="{Binding Prefixe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

      <TextBlock Grid.Row="2" Grid.Column="2" Text="Suffixe"
                 FontSize="11" Margin="0,10,0,4"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
      <TextBox Grid.Row="3" Grid.Column="2"
               Text="{Binding Suffixe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

      <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                  Orientation="Horizontal" Margin="0,12,0,0">
        <CheckBox IsChecked="{Binding UseRegex, Mode=TwoWay}"
                  Style="{DynamicResource CheckBoxStyle}"
                  Content="Expression régulière"/>
        <TextBlock Text="jetons : {n} {date} {annee} {mois} {jour}"
                   FontSize="11"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="2"
               Text="{Binding RegexError}"
               FontSize="11"
               TextWrapping="Wrap"
               Foreground="{DynamicResource WarningBrush}"
               Margin="0,0,0,8">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasRegexError}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Apercus}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="2,7">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Ancien}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="&#x2192;"
                           Margin="10,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Nouveau}"
                           TextTrimming="CharacterEllipsis">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <!-- Inchangé : reste en retrait -->
                      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Change}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                          <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="4" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 Text="{Binding Etat}"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <Button Grid.Column="1"
              x:Name="RenommerButton"
              Content="Renommer"
              Style="{DynamicResource PrimaryActionButtonStyle}"
              IsEnabled="{Binding PeutRenommer}"/>
    </Grid>
  </Grid>
</UserControl>
