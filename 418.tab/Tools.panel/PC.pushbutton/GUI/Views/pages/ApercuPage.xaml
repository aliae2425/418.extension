<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Page Aperçu — DataContext = ApercuPageVM.

    L'outil ÉCRIT dans le projet : des feuilles et des jeux que personne n'a
    demandés sont plus longs à retirer qu'à créer. Ce qui s'affiche ici vient
    du même planifier() que ce qui s'exécute — pas deux calculs qui se
    ressemblent, le même plan.
  -->

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVersVisibilite"/>
  </UserControl.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{Binding Resume}" Margin="0,0,0,10"
               Foreground="{DynamicResource TextSecondaryBrush}"
               FontSize="12"/>

    <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="12,10">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Lignes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Dessin}"
                           FontFamily="Consolas" FontSize="12"
                           Margin="0,0,6,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <TextBlock Grid.Column="1" Text="{Binding Nom}"
                           FontFamily="Consolas" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <!-- Le jeu porte la ligne, les feuilles s'y rangent. -->
                        <DataTrigger Binding="{Binding EstJeu}" Value="True">
                          <Setter Property="FontWeight" Value="SemiBold"/>
                          <Setter Property="Foreground"
                                  Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <!-- « existe déjà » n'est pas une erreur : on n'y touche
                     pas, et l'outil se rejoue sans rien écraser. -->
                <TextBlock Grid.Column="2" Text="  (existe déjà)"
                           FontSize="11" VerticalAlignment="Center"
                           Visibility="{Binding Existe, Converter={StaticResource BoolVersVisibilite}}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <TextBlock Grid.Column="3" Text="{Binding Detail}"
                           FontSize="11" VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding DetailVisible, Converter={StaticResource BoolVersVisibilite}}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Text="{Binding Avertissement}" VerticalAlignment="Center"
                 FontSize="12"
                 Visibility="{Binding AvertissementVisible, Converter={StaticResource BoolVersVisibilite}}"
                 Foreground="{DynamicResource WarningBrush}"/>
      <Button x:Name="RunButton"
              Content="Créer dans la maquette"
              IsEnabled="{Binding PeutCreer}"
              Style="{DynamicResource PrimaryActionButtonStyle}"
              HorizontalAlignment="Right"/>
    </Grid>
  </Grid>
</UserControl>
