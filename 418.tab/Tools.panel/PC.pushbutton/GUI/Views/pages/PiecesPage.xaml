<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Page Pièces — DataContext = PiecesPageVM.

    Pas la page Sélection du socle, et ce n'est pas un oubli : celle-ci porte
    une colonne de plus, le verdict de l'analyse du projet. SelectionItemVM ne
    connaît qu'un identifiant et un nom — l'y forcer aurait tordu un VM
    partagé par six outils pour un besoin qui n'appartient qu'à celui-ci.
  -->

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Barre : compte + boutons de masse -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="{Binding Resume}" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 FontSize="12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SelectAllButton" Content="Tout cocher"
                Style="{DynamicResource SecondaryActionButtonStyle}"
                Margin="0,0,6,0"/>
        <Button x:Name="DeselectAllButton" Content="Tout décocher"
                Style="{DynamicResource SecondaryActionButtonStyle}"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="4">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Pieces}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="8,7" Margin="0,1" CornerRadius="6"
                      Background="{DynamicResource TransparentBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding Coche, Mode=TwoWay}"
                            Style="{DynamicResource CheckBoxStyle}"
                            VerticalAlignment="Center"/>

                  <!-- Le code du bordereau : c'est lui que l'instructeur lit
                       en premier, et lui qui ordonne les dossiers. -->
                  <TextBlock Grid.Column="1" Text="{Binding Code}"
                             Width="56" VerticalAlignment="Center"
                             FontWeight="SemiBold" FontSize="12"
                             Foreground="{DynamicResource AccentBrush}"/>

                  <StackPanel Grid.Column="2" Orientation="Vertical"
                              VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Libelle}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Libelle}"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Mention}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>

                  <!-- Le compte vient du projet, pas d'un réglage : c'est
                       la colonne qui le justifie. -->
                  <Border Grid.Column="3" VerticalAlignment="Center"
                          CornerRadius="10" Padding="9,3"
                          Background="{DynamicResource ControlFillBrush}">
                    <TextBlock FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                      <Run Text="{Binding Feuilles, Mode=OneWay}"/>
                      <Run Text=" feuille(s)"/>
                    </TextBlock>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Button Grid.Row="2" x:Name="NextToApercuButton"
            Content="Suivant ›"
            Style="{DynamicResource PrimaryActionButtonStyle}"
            HorizontalAlignment="Right"
            Margin="0,10,0,0"/>
  </Grid>
</UserControl>
