<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Importer SVG"
        Width="420" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource TransparentBrush}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=ValeurTextBox}">

  <!--
    Saisie de la largeur d'import du SVG. Même coquille que
    BatchExport/GUI/Modals/NamingEditor.xaml : chrome borderless dessiné par le
    Border racine, TitleBar draggable et CloseButton câblés par BaseWindow,
    tout brush/style en DynamicResource (fusionnés APRÈS le parse, donc jamais
    en StaticResource).

    PAS de ViewModel : un seul champ, la vue lit ValeurTextBox.Text au clic.
    D'où les libellés en dur ici et l'absence de DataContext — seul
    InfoTextBlock est renseigné par la vue (dimensions natives du SVG).

    Clavier : géré nativement par WPF, aucun code — IsDefault sur Importer
    (Entrée), IsCancel sur Annuler (Échap).
  -->

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>

  <Border CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Barre de titre draggable -->
      <Grid Grid.Row="0" x:Name="TitleBar" Height="44" Background="{DynamicResource TransparentBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="Importer SVG"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12.5"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="14,0,0,0"/>

        <Button x:Name="CloseButton"
                Grid.Column="1"
                Content="&#x2715;"
                Style="{DynamicResource CaptionCloseButtonStyle}"
                Margin="0,0,4,0"/>
      </Grid>

      <!-- Corps -->
      <Grid Grid.Row="1" Margin="20,4,20,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Largeur cible"
                       Style="{DynamicResource SubHeaderTextBlockStyle}"
                       Margin="0,0,0,4"/>

            <TextBlock Grid.Row="1"
                       Text="Largeur du tracé dans le modèle. Sur une feuille, elle apparaîtra divisée par l'échelle de la vue."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,10"/>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBox x:Name="ValeurTextBox"
                       Grid.Column="0"
                       FontFamily="Consolas"/>

              <TextBlock Grid.Column="1"
                         Text="mm"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="8,0,0,0"/>
            </Grid>

            <TextBlock Grid.Row="3"
                       x:Name="InfoTextBlock"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,8,0,0"/>
          </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="1" LastChildFill="False">
          <Button x:Name="CancelButton"
                  DockPanel.Dock="Right"
                  Content="Annuler"
                  IsCancel="True"
                  Style="{DynamicResource SecondaryActionButtonStyle}"
                  Margin="8,0,0,0"/>
          <Button x:Name="OkButton"
                  DockPanel.Dock="Right"
                  Content="Importer"
                  IsDefault="True"
                  Style="{DynamicResource PrimaryActionButtonStyle}"/>
        </DockPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
