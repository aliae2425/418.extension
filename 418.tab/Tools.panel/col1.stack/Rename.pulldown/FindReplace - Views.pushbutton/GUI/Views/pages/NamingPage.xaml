<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Page Nommage — DataContext = NamingPageVM (vues).
    XamlReader.Load, pas de x:Class. Tout brush/style en DynamicResource.
  -->

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="14">
    <StackPanel Orientation="Vertical">

      <!-- Grille nommage : 1 ligne (Nom vue) x 4 champs -->
      <Border Style="{DynamicResource CardStyle}" Padding="12,10">
        <StackPanel Orientation="Vertical">
          <TextBlock Text="Nommage"
                     Style="{DynamicResource SubHeaderTextBlockStyle}"
                     Margin="0,0,0,8"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-t&#234;tes colonnes -->
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="Pr&#233;fixe"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11" Margin="4,0,4,6"/>
            <TextBlock Grid.Row="0" Grid.Column="2"
                       Text="Rechercher (regex)"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11" Margin="4,0,4,6"/>
            <TextBlock Grid.Row="0" Grid.Column="3"
                       Text="Remplacer"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11" Margin="4,0,4,6"/>
            <TextBlock Grid.Row="0" Grid.Column="4"
                       Text="Suffixe"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11" Margin="4,0,0,6"/>

            <!-- Ligne Nom vue -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Nom vue"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" FontSize="12"
                       VerticalAlignment="Top" Margin="0,5,10,0"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding ViewPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="4,0,4,0" VerticalAlignment="Top"/>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" Margin="4,0,4,0">
              <TextBox Text="{Binding ViewFind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Text="{Binding RegexError}"
                         Foreground="#E05252" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasRegexError}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <TextBox Grid.Row="1" Grid.Column="3"
                     Text="{Binding ViewReplace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="4,0,4,0" VerticalAlignment="Top"/>
            <TextBox Grid.Row="1" Grid.Column="4"
                     Text="{Binding ViewSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="4,0,0,0" VerticalAlignment="Top"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Aper&#231;u des vues renomm&#233;es -->
      <Border Style="{DynamicResource CardStyle}" Padding="12,10">
        <StackPanel Orientation="Vertical">
          <TextBlock Text="Aper&#231;u"
                     Style="{DynamicResource SubHeaderTextBlockStyle}"
                     Margin="0,0,0,8"/>

          <Border Background="{DynamicResource ControlFillBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="12" MinHeight="44">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasPreview}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="S&#233;lectionnez des vues pour voir l&#8217;aper&#231;u."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontStyle="Italic" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <ItemsControl ItemsSource="{Binding PreviewGroups}">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasPreview}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="0,0,0,1" Padding="2,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding OriginalLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1"
                               Text="&#8594;"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="13" VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding NomGenere}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Action -->
      <Button x:Name="RunButton"
              Content="Renommer les vues s&#233;lectionn&#233;es"
              Style="{DynamicResource PrimaryActionButtonStyle}"
              HorizontalAlignment="Right"
              Margin="0,4,0,0"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
