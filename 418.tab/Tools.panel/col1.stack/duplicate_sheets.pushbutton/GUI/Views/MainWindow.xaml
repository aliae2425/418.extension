<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Titre}"
        Width="720" Height="560"
        MinWidth="560" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource TransparentBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

  <!--
    Fenêtre Dupliquer les feuilles — coquille borderless à rail, calquée sur
    la coquille commune Audit.

    Chargement
    - Ce XAML est chargé via XamlReader.Load (PAS de x:Class, PAS de code-behind).
    - Les dictionnaires de thème (Colors/Styles + variantes Dark) sont fusionnés
      dans window.Resources APRÈS le parse.
    - CONSÉQUENCE : tout brush/style de thème est référencé via DynamicResource.

    Chrome custom borderless
    - WindowStyle="None" + AllowsTransparency : chrome dessiné par le Border racine.
    - WindowChrome : redimensionnement / maximize corrects (CaptionHeight=0 pour
      laisser le TitleBar custom gérer le DragMove côté Python).
    - TitleBar (x:Name requis) : le Python y câble DragMove().
    - Boutons de légende nommés : MinimizeButton / MaximizeRestoreButton / CloseButton.

    Rail de navigation
    - Deux RadioButton GroupName="nav" : NavSelection / NavOptions.
    - PageHost (ContentControl) reçoit la page courante (Sélection ou Options),
      chargée séparément via XamlReader et injectée par la View (Task 10).
  -->

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>

  <!-- Border racine : coins arrondis, fond de fenêtre -->
  <Border CornerRadius="12"
          Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!--
        Barre de titre (draggable côté Python via x:Name="TitleBar").
        Titre à gauche, boutons de légende à droite.
      -->
      <Grid Grid.Row="0" x:Name="TitleBar"
            Height="44"
            Background="{DynamicResource TransparentBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="418 · Dupliquer les feuilles"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12.5"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="14,0,0,0"/>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
          <Button x:Name="MinimizeButton"
                  Content="&#x2013;"
                  Style="{DynamicResource CaptionButtonStyle}"/>
          <Button x:Name="MaximizeRestoreButton"
                  Content="&#x25A1;"
                  Style="{DynamicResource CaptionButtonStyle}"/>
          <Button x:Name="CloseButton"
                  Content="&#x2715;"
                  Style="{DynamicResource CaptionCloseButtonStyle}"/>
        </StackPanel>
      </Grid>

      <!-- Corps : rail (Width 64) + surface de contenu (*) -->
      <Grid Grid.Row="1" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
          Rail de navigation : DockPanel vertical.
          Logo en haut, puis les deux items de nav (Sélection / Options).
        -->
        <DockPanel Grid.Column="0"
                   LastChildFill="True"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,10">

          <!-- Pastille logo de marque (dégradé accent) -->
          <Border DockPanel.Dock="Top"
                  Style="{DynamicResource BrandLogoBorderStyle}"
                  Margin="0,0,0,8">
            <Image Source="{Binding BrandLogoPath}" Width="30" Height="30"/>
          </Border>

          <!-- Conteneur de navigation -->
          <StackPanel Orientation="Vertical"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
            <RadioButton x:Name="NavSelection"
                         GroupName="nav"
                         Style="{DynamicResource NavRailButtonStyle}"
                         Content="&#x2611;"
                         ToolTip="S&#233;lection"
                         Margin="0,0,0,6"/>
            <RadioButton x:Name="NavParams"
                         GroupName="nav"
                         Style="{DynamicResource NavRailButtonStyle}"
                         Content="&#x2699;"
                         ToolTip="Param&#232;tres"
                         Margin="0,0,0,6"/>
            <RadioButton x:Name="NavOptions"
                         GroupName="nav"
                         Style="{DynamicResource NavRailButtonStyle}"
                         Content="&#x270E;"
                         ToolTip="Nommage"/>
          </StackPanel>
        </DockPanel>

        <!-- Surface de contenu flottante : héberge la page courante -->
        <Border Grid.Column="1"
                Style="{DynamicResource ShellSurfaceStyle}"
                Margin="6,0,12,12">
          <ContentControl x:Name="PageHost"/>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
