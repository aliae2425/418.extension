<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Page Sélection — DataContext = SelectionPageVM (assigné par le Python).
    Chargée via XamlReader.Load et injectée dans PageHost (PAS de x:Class,
    PAS de code-behind). Tout brush/style de thème en DynamicResource.
  -->

  <Grid Background="{DynamicResource TransparentBrush}"
        Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Feuilles à dupliquer"
               Style="{DynamicResource HeaderTextBlockStyle}"
               Margin="0,0,0,14"/>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="4,8">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          Style="{DynamicResource CheckBoxStyle}"
                          Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Numero}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="Bold"
                           Width="90"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Nom}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
