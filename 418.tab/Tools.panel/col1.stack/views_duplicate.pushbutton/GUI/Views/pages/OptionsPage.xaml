<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Page Options DataContext = OptionsPageVM.
    Charg&#233;e via XamlReader.Load. Tout brush/style en DynamicResource.
  -->

  <UserControl.Resources>

    <!-- Puce radio : pill/chip accent quand coch&#233;e -->
    <Style x:Key="RadioChipStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="border"
                    Background="{DynamicResource ControlFillBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="IsChecked" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlFillHoverBrush}"/>
                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}"/>
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="IsChecked" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="20">
    <StackPanel Orientation="Vertical">

      <!-- Carte 1 : mode de duplication + nombre de copies sur la m&#234;me ligne -->
      <Border Style="{DynamicResource CardStyle}">
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Radios pill -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton x:Name="RadioDuplicate"
                         GroupName="dupopt"
                         Tag="duplicate"
                         Content="Dupliquer"
                         Style="{StaticResource RadioChipStyle}"
                         IsChecked="True"/>
            <RadioButton x:Name="RadioDetailing"
                         GroupName="dupopt"
                         Tag="with_detailing"
                         Content="Avec d&#233;tails"
                         Style="{StaticResource RadioChipStyle}"/>
            <RadioButton x:Name="RadioDependent"
                         GroupName="dupopt"
                         Tag="as_dependent"
                         Content="D&#233;pendante"
                         Style="{StaticResource RadioChipStyle}"/>
          </StackPanel>

          <!-- Nombre de copies -->
          <StackPanel Grid.Column="1" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="16,0,0,0">
            <TextBlock Text="Copies :"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox Text="{Binding Count, Mode=TwoWay}"
                     Width="52"
                     VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Carte 2 : nommage (pr&#233;fixe / rechercher / remplacer / suffixe) -->
      <Border Style="{DynamicResource CardStyle}">
        <StackPanel Orientation="Vertical">
          <TextBlock Text="Nommage"
                     Style="{DynamicResource SubHeaderTextBlockStyle}"
                     Margin="0,0,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0">
              <TextBlock Text="Pr&#233;fixe"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="11" Margin="0,0,0,4"/>
              <TextBox Text="{Binding Prefixe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,8,0">
              <TextBlock Text="Rechercher (regex)"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="11" Margin="0,0,0,4"/>
              <TextBox Text="{Binding Rechercher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              <!-- Indicateur d'erreur regex -->
              <TextBlock Text="{Binding RegexError}"
                         Foreground="#E05252"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Margin="0,3,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasRegexError}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,8,0">
              <!-- En-t&#234;te Remplacer + ic&#244;ne d'aide sur les tokens -->
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Remplacer"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="&#9432;"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="12" FontWeight="Bold"
                           Margin="4,0,0,0" VerticalAlignment="Center"
                           Cursor="Hand"
                           ToolTipService.InitialShowDelay="150"
                           ToolTipService.ShowDuration="30000">
                  <TextBlock.ToolTip>
                    <ToolTip MaxWidth="340">
                      <StackPanel Margin="2">
                        <TextBlock Text="Tokens disponibles" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="{}{date}  &#8212;  date du jour (AAAA-MM-JJ)" Margin="0,1"/>
                        <TextBlock Text="{}{annee} &#8212;  ann&#233;e sur 4 chiffres" Margin="0,1"/>
                        <TextBlock Text="{}{mois}  &#8212;  mois sur 2 chiffres" Margin="0,1"/>
                        <TextBlock Text="{}{jour}  &#8212;  jour sur 2 chiffres" Margin="0,1"/>
                        <TextBlock Text="{}{n}     &#8212;  num&#233;ro de la copie (1, 2, 3&#8230;)" Margin="0,1"/>
                        <TextBlock Text="{}{type}  &#8212;  type de la vue" Margin="0,1"/>
                        <TextBlock Text="Utilisables dans Pr&#233;fixe, Remplacer et Suffixe."
                                   FontStyle="Italic" Margin="0,6,0,0"/>
                      </StackPanel>
                    </ToolTip>
                  </TextBlock.ToolTip>
                </TextBlock>
              </StackPanel>
              <TextBox Text="{Binding Remplacer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Vertical">
              <TextBlock Text="Suffixe"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="11" Margin="0,0,0,4"/>
              <TextBox Text="{Binding Suffixe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Carte 3 : aper&#231;u des noms cr&#233;&#233;s, group&#233;s par vue d'origine -->
      <Border Style="{DynamicResource CardStyle}">
        <StackPanel Orientation="Vertical">
          <TextBlock Text="Aper&#231;u des noms cr&#233;&#233;s"
                     Style="{DynamicResource SubHeaderTextBlockStyle}"
                     Margin="0,0,0,10"/>

          <!-- &#201;tat vide : aucune vue s&#233;lectionn&#233;e -->
          <Border Background="{DynamicResource ControlFillBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="16" MinHeight="56">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasPreview}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="S&#233;lectionnez des vues pour voir l&#8217;aper&#231;u."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontStyle="Italic" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <!-- Liste group&#233;e par vue source -->
          <ItemsControl ItemsSource="{Binding PreviewGroups}">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasPreview}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="4,8">
                  <StackPanel Orientation="Vertical">

                    <!-- En-t&#234;te du groupe : vue d'origine + badge nombre de copies -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,5">
                      <Border DockPanel.Dock="Right"
                              Background="{DynamicResource ControlFillBrush}"
                              BorderBrush="{DynamicResource ControlBorderBrush}"
                              BorderThickness="1" CornerRadius="8"
                              Padding="6,1" Margin="8,0,0,0"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding CountLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"/>
                      </Border>
                      <TextBlock Text="{Binding NomOriginal}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 FontSize="11"
                                 VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Copies g&#233;n&#233;r&#233;es (une par copie) -->
                    <ItemsControl ItemsSource="{Binding Copies}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding IndexLabel}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Width="18"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="&#8594;&#160;"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Nom}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </Border>

      <!-- Bouton d&#8217;action -->
      <Button x:Name="RunButton"
              Content="Dupliquer les vues s&#233;lectionn&#233;es"
              Style="{DynamicResource PrimaryActionButtonStyle}"
              HorizontalAlignment="Right"
              Margin="0,4,0,0"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
