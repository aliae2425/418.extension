<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Titre}"
        Width="720" Height="560"
        MinWidth="560" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource TransparentBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

  <!--
    Coquille borderless à rail, PARTAGÉE par tous les outils qui héritent de
    RailWindow. Elle remplace les exemplaires quasi identiques que chaque
    bouton portait dans son GUI/Views/. Ce qui variait devient de la donnée :

      - le titre       -> {Binding Titre} du ViewModel racine
      - les onglets    -> RailWindow.ONGLETS, dont l'icône et l'infobulle ;
                          les RadioButton sont construits côté Python et
                          insérés dans NavItems
      - la taille      -> RailWindow.TAILLE / TAILLE_MINI, appliquées après
                          le parse

    Un outil qui a besoin d'une coquille à lui dépose un MainWindow.xaml dans
    son propre GUI/Views/ : RailWindow le préfère à celui-ci, exactement
    comme pour les pages (cf. _chemin_page).

    Chargement
    - Chargée via XamlReader.Load (PAS de x:Class, PAS de code-behind).
    - Les dictionnaires de thème sont fusionnés dans window.Resources APRÈS
      le parse -> tout brush/style de thème est en DynamicResource.

    Chrome custom borderless
    - WindowStyle="None" + AllowsTransparency : chrome dessiné par le Border
      racine ; WindowChrome pour un redimensionnement correct.
    - TitleBar (x:Name requis) : BaseWindow y câble DragMove().
    - Boutons de légende : MinimizeButton / MaximizeRestoreButton / CloseButton.
    - PageHost (ContentControl) reçoit la page courante.
  -->

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>

  <Border CornerRadius="12"
          Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" x:Name="TitleBar"
            Height="44"
            Background="{DynamicResource TransparentBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding Titre}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12.5"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="14,0,0,0"/>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
          <Button x:Name="MinimizeButton"
                  Content="&#x2013;"
                  Style="{DynamicResource CaptionButtonStyle}"/>
          <Button x:Name="MaximizeRestoreButton"
                  Content="&#x25A1;"
                  Style="{DynamicResource CaptionButtonStyle}"/>
          <Button x:Name="CloseButton"
                  Content="&#x2715;"
                  Style="{DynamicResource CaptionCloseButtonStyle}"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0"
                   LastChildFill="True"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,10">

          <Border DockPanel.Dock="Top"
                  Style="{DynamicResource BrandLogoBorderStyle}"
                  Margin="0,0,0,8">
            <Image Source="{Binding BrandLogoPath}" Width="30" Height="30"/>
          </Border>

          <!-- Rempli par RailWindow._construire_nav depuis ONGLETS. -->
          <StackPanel x:Name="NavItems"
                      Orientation="Vertical"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"/>
        </DockPanel>

        <Border Grid.Column="1"
                Style="{DynamicResource ShellSurfaceStyle}"
                Margin="6,0,12,12">
          <ContentControl x:Name="PageHost"/>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
