<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenArchi"
        Width="420" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{DynamicResource TransparentBrush}"
        WindowStartupLocation="CenterScreen">

  <!--
    Modale de la commande /config (lib/ui/OpenArchiConfigVM.py)
    - Chargée par BaseWindow : thème fusionné APRÈS le parse => DynamicResource
      uniquement, aucun StaticResource.
    - TitleBar (x:Name requis) : BaseWindow y câble le DragMove().
    - Valider applique ET ferme : la commande s'exécute au clic, IsCancel
      referme ensuite la boîte de dialogue.
  -->

  <Border CornerRadius="8"
          Background="{DynamicResource WindowBackgroundBrush}"
          BorderBrush="{DynamicResource ControlBorderBrush}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource TransparentBrush}">
        <TextBlock Text="Configuration OpenArchi"
                   Style="{DynamicResource HeaderTextBlockStyle}"
                   Margin="16,12,0,0" VerticalAlignment="Center"/>
      </Grid>

      <StackPanel Grid.Row="1" Margin="16,12,16,16">

        <TextBlock Text="Fournisseur" Style="{DynamicResource BodyTextBlockStyle}"
                   Margin="2,0,0,4"/>
        <ComboBox ItemsSource="{Binding Providers}"
                  SelectedItem="{Binding Provider, Mode=TwoWay}"/>

        <TextBlock Text="Modèle" Style="{DynamicResource BodyTextBlockStyle}"
                   Margin="2,14,0,4"/>
        <ComboBox ItemsSource="{Binding Modeles}"
                  SelectedItem="{Binding Modele, Mode=TwoWay}"/>

        <TextBlock Text="Projet ouvert" Style="{DynamicResource BodyTextBlockStyle}"
                   Margin="2,14,0,4"/>
        <ComboBox ItemsSource="{Binding Projets}"
                  SelectedItem="{Binding Projet, Mode=TwoWay}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,20,0,0">
          <Button Content="Annuler"
                  Style="{DynamicResource SecondaryActionButtonStyle}"
                  Width="90" Height="35" Margin="0,0,8,0"
                  IsCancel="True"/>
          <Button Content="Valider"
                  Style="{DynamicResource PrimaryButtonStyle}"
                  Width="90" Height="35"
                  Command="{Binding ValiderCommand}"
                  IsCancel="True"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
