<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Presse-papiers" Width="360" SizeToContent="Height" MaxHeight="440"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual">

  <!--
    Popup façon Win+V (lib/ui/PressePapiersPopup.py). Le clavier est tenu par
    la fenêtre (PreviewKeyDown), pas par la liste : rien ne dépend du focus.
    Gabarit de ligne identique au panneau (pages/PressePapiersPanel.xaml).
  -->

  <Border Margin="8" Padding="8" CornerRadius="10"
          Background="{DynamicResource CardBackgroundBrush}"
          BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
    </Border.Effect>
    <Grid>
      <Grid.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVersVisibilite"/>
      </Grid.Resources>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="4,10" HorizontalAlignment="Center"
                  Visibility="{Binding EstVide, Converter={StaticResource BoolVersVisibilite}}">
        <Path Data="{DynamicResource IconPressePapiersPanneau}"
              Width="28" Height="28" Stretch="Uniform" Opacity="0.5"
              StrokeThickness="1.5" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Stroke="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock Margin="0,6,0,0" FontSize="12" TextAlignment="Center"
                   Text="Historique vide : rien n'a encore été copié."
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
      </StackPanel>

      <ListBox x:Name="Liste" Grid.Row="1" ItemsSource="{Binding Lignes}"
               SelectedItem="{Binding Selection, Mode=TwoWay}"
               HorizontalContentAlignment="Stretch" Focusable="False"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="2,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Libelle}" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <TextBlock Text="{Binding Heure}" FontSize="10"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBlock Text="{Binding Source}" FontSize="10" Margin="8,0,0,0"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBlock Text="{Binding Ignores}" FontSize="10" Margin="8,0,0,0"
                             Foreground="{DynamicResource WarningBrush}"
                             Visibility="{Binding IgnoresVisible, Converter={StaticResource BoolVersVisibilite}}"/>
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Margin="8,0,0,0" Padding="6,1" CornerRadius="6"
                      VerticalAlignment="Top"
                      BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}">
                <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"/>
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="2" Margin="4,8,4,0" FontSize="10" TextWrapping="Wrap"
                 Text="1 / Entrée : même endroit · 2 : vue courante · 3 : point · Suppr : retirer · Échap"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
  </Border>
</Window>
