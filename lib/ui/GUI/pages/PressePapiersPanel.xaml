<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackgroundBrush}">

  <!--
    Panneau ancrable Presse-papiers (lib/ui/PressePapiersPanel.py).
    Thème fusionné dans Page.Resources AVANT le parse : DynamicResource
    partout. Le gabarit de ligne est le même que celui de la popup
    (lib/ui/GUI/PressePapiersPopup.xaml) : les garder en accord.
  -->

  <Grid Margin="10,10,10,6">
    <Grid.Resources>
      <BooleanToVisibilityConverter x:Key="BoolVersVisibilite"/>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ListBox Grid.Row="0" ItemsSource="{Binding Lignes}"
             SelectedItem="{Binding Selection, Mode=TwoWay}"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="2,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding Libelle}" FontSize="12" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="{Binding Heure}" FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding Source}" FontSize="10" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding Ignores}" FontSize="10" Margin="8,0,0,0"
                           Foreground="{DynamicResource WarningBrush}"
                           Visibility="{Binding IgnoresVisible, Converter={StaticResource BoolVersVisibilite}}"/>
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="6,1" CornerRadius="6"
                    VerticalAlignment="Top"
                    BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}">
              <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"/>
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Après la liste : par-dessus elle dans l'ordre de dessin. -->
    <StackPanel Grid.Row="0" Margin="16" VerticalAlignment="Center"
                HorizontalAlignment="Center" IsHitTestVisible="False"
                Visibility="{Binding EstVide, Converter={StaticResource BoolVersVisibilite}}">
      <Path Data="{DynamicResource IconPressePapiersPanneau}"
            Width="40" Height="40" Stretch="Uniform" Opacity="0.5"
            StrokeThickness="1.5" StrokeStartLineCap="Round"
            StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Stroke="{DynamicResource TextSecondaryBrush}"/>
      <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                 TextAlignment="Center"
                 Text="Historique vide. Chaque Ctrl+C dans Revit y ajoute une entrée."
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>

    <UniformGrid Grid.Row="1" Rows="1" Margin="0,10,0,0">
      <Button Content="Même endroit" Margin="0,0,4,0"
              ToolTip="Coller au même emplacement que la copie"
              Command="{Binding CollerMemeEmplacementCommand}"/>
      <Button Content="Vue courante" Margin="2,0"
              ToolTip="Coller aligné sur la vue courante"
              Command="{Binding CollerVueCouranteCommand}"/>
      <Button Content="Point…" Margin="4,0,0,0"
              ToolTip="Collage normal : cliquer un point dans la vue"
              Command="{Binding CollerNormalCommand}"/>
    </UniformGrid>

    <UniformGrid Grid.Row="2" Rows="1" Margin="0,6,0,0">
      <Button Content="Retirer" Margin="0,0,3,0" Command="{Binding RetirerCommand}"/>
      <Button Content="Vider" Margin="3,0,0,0" Command="{Binding ViderCommand}"/>
    </UniformGrid>

    <TextBlock Grid.Row="3" Text="{Binding Etat}" Margin="4,8,4,2" FontSize="10"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}"/>
  </Grid>
</Page>
