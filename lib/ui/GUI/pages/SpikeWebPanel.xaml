<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackgroundBrush}">

  <!--
    Banc d'essai WebView2 (lib/ui/SpikeWebPanel.py). Jetable.

    Le WebView2 n'est PAS déclaré ici, et ce n'est pas un oubli : XamlReader
    devrait résoudre le namespace clr au moment du parse, ce qui échoue tant
    que l'assembly n'est pas référencée. Il est instancié en Python et injecté
    dans `Hote` par `.Child`. Même raison que dans RampeParking.

    Les dictionnaires de thème sont fusionnés dans Page.Resources AVANT le
    parse : DynamicResource partout, aucun StaticResource.
  -->

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- barre -->
      <RowDefinition Height="*"/>      <!-- la page web -->
      <RowDefinition Height="160"/>    <!-- le verdict -->
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
      <Button x:Name="Verifier"
              Content="Vérifier après ancrage"
              Padding="10,4"
              ToolTip="Ancrer, désancrer, faire flotter, ré-ancrer — puis cliquer."/>
      <TextBlock Text="banc jetable — ne se connecte à rien"
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>

    <!-- Hote reçoit le WebView2 depuis SpikeWebPanel. Si le contrôle ne peut
         pas être créé, le message reste en place et le verdict dit pourquoi. -->
    <Border Grid.Row="1"
            x:Name="Hote"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Background="{DynamicResource CardBackgroundBrush}">
      <TextBlock Text="WebView2 non créé — le volet doit être affiché."
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Border>

    <!-- Texte sélectionnable, donc collable dans un rapport : un TextBlock ne
         le permet pas sous WPF, d'où un TextBox en lecture seule.

         `Height="Auto"` n'est PAS décoratif : le style implicite de TextBox
         (Styles.xaml) pose `Height="35"`, et sans valeur locale pour le
         battre le verdict tiendrait sur deux lignes. Pas de ScrollViewer
         autour non plus — un TextBox défile déjà seul (PART_ContentHost), et
         l'imbriquer ferait défiler un conteneur plus petit que son contenu. -->
    <TextBox Grid.Row="2"
             x:Name="Verdict"
             Margin="0,8,0,0"
             Height="Auto"
             VerticalContentAlignment="Top"
             VerticalScrollBarVisibility="Auto"
             IsReadOnly="True"
             TextWrapping="Wrap"
             Background="Transparent"
             BorderThickness="0"
             FontFamily="Consolas"
             FontSize="11"
             IsTabStop="False"
             Foreground="{DynamicResource TextPrimaryBrush}"
             SelectionBrush="{DynamicResource AccentBrush}"/>
  </Grid>
</Page>
