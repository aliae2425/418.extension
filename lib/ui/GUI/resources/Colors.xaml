<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fluent UI Palette -->
    
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MicaBackgroundBrush" Color="#F3F3F3"/>
    
    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D5D5D"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#9D9D9D"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
    <!-- Hover overlay text must be forced to white (light/dark) -->
    <SolidColorBrush x:Key="HoverTextBrush" Color="#FFFFFF"/>
    
    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#006CC1"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#005A9E"/>
    
    <!-- Controls -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#C0C0C0"/>

    <!-- Aliases / UI states -->
    <SolidColorBrush x:Key="ControlMouseOverBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#80000000"/>
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#FFE81123"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#D13438"/>
    <SolidColorBrush x:Key="TextOnDangerBrush" Color="#FFFFFF"/>

    <!-- Couleurs sémantiques (états) — thème clair -->
    <!-- SuccessBrush (vert) / WarningBrush (orange) / ErrorBrush (rouge, ci-dessus)
         couvrent déjà le triptyque bon/à revoir/critique du dashboard Audit :
         réutilisées telles quelles, pas de doublon GoodBrush/WarnBrush. -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E9E4F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B8860B"/>

    <!-- Palette par thème du donut d'audit (une couleur distincte par section) -->
    <SolidColorBrush x:Key="CatWarningsBrush" Color="#D98B1F"/>
    <SolidColorBrush x:Key="CatPurgeBrush" Color="#7A5AD9"/>
    <SolidColorBrush x:Key="CatVuesBrush" Color="#1F7FD9"/>
    <SolidColorBrush x:Key="CatCadBrush" Color="#D93B57"/>
    <SolidColorBrush x:Key="CatNommageBrush" Color="#1FA88C"/>

    <!-- Non-brush color resources (for properties expecting Color) -->
    <Color x:Key="ShadowColor">#000000</Color>
    
    <!-- Legacy/Existing keys mapped to new ones -->
    <SolidColorBrush x:Key="LightGrayBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="MediumGrayBrush" Color="#E0E0E0"/>

    <!-- Coquille commune (barre commune Fluent) -->
    <!-- Accent secondaire (thème clair) -->
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#00B7C3"/>
    <!-- Dégradé de marque : AccentBrush -> AccentSecondaryBrush (couleurs en dur, un GradientBrush ne référence pas d'autres brushes) -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0078D4"/>
        <GradientStop Offset="1" Color="#00B7C3"/>
    </LinearGradientBrush>

    <!-- Interrupteur (ToggleSwitchStyle) : thumb à l'état ON, blanc constant
         (indépendant du thème, contrairement à TextOnAccentBrush qui devient
         sombre en dark mode et disparaîtrait sur la piste accentuée). -->
    <SolidColorBrush x:Key="ToggleThumbCheckedBrush" Color="#FFFFFF"/>
</ResourceDictionary>
